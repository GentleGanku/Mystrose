<UserControl
    x:Class="Mystrose.ScriptMachine.ScriptEnginePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Mystrose.ScriptMachine.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Mystrose.ScriptMachine"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="600"
    d:DesignWidth="750"
    Loaded="Engine_Loaded"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            Margin="0,3"
            HorizontalAlignment="Center"
            BorderBrush="#373640"
            BorderThickness="1"
            CornerRadius="6">
            <StackPanel Name="ScriptViews" Orientation="Horizontal">

                <ui:Button
                    x:Name="CommandsBtn"
                    Height="40"
                    Margin="5,0,10,0"
                    Background="Transparent"
                    Click="View_Click"
                    Cursor="Hand"
                    MouseOverBackground="Transparent"
                    PressedBackground="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon
                            x:Name="CommandsIcn"
                            Grid.Column="0"
                            FontSize="20"
                            Symbol="Layer24" />
                        <TextBlock
                            x:Name="CommandsTxt"
                            Grid.Column="1"
                            Margin="5,0,0,2.5"
                            FontSize="16"
                            FontWeight="Bold"
                            Text="Commands" />
                    </Grid>
                </ui:Button>
                <Border
                    Grid.Column="1"
                    Width="1"
                    Height="20"
                    Background="#373640"
                    CornerRadius="0.5" />
                <ui:Button
                    x:Name="TriggersBtn"
                    Grid.Column="2"
                    Height="40"
                    Margin="5,0,10,0"
                    Background="Transparent"
                    Click="View_Click"
                    Cursor="Hand"
                    MouseOverBackground="Transparent"
                    PressedBackground="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon
                            x:Name="TriggersIcn"
                            Grid.Column="0"
                            FontSize="20"
                            Symbol="TapSingle24" />
                        <TextBlock
                            x:Name="TriggersTxt"
                            Grid.Column="1"
                            Margin="5,0,0,2.5"
                            FontSize="16"
                            FontWeight="Bold"
                            Text="Triggers" />
                    </Grid>
                </ui:Button>
                <Border
                    Grid.Column="3"
                    Width="1"
                    Height="20"
                    Background="#373640"
                    CornerRadius="0.5" />
                <ui:Button
                    x:Name="VariablesBtn"
                    Grid.Column="4"
                    Height="40"
                    Margin="5,0,10,0"
                    Background="Transparent"
                    Click="View_Click"
                    Cursor="Hand"
                    MouseOverBackground="Transparent"
                    PressedBackground="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ui:SymbolIcon
                            x:Name="VariablesIcn"
                            Grid.Column="0"
                            FontSize="20"
                            Symbol="BracesVariable24" />
                        <TextBlock
                            x:Name="VariablesTxt"
                            Grid.Column="1"
                            Margin="5,0,0,2.5"
                            FontSize="16"
                            FontWeight="Bold"
                            Text="Variables" />
                    </Grid>
                </ui:Button>
            </StackPanel>
        </Border>
        <Grid
            Name="ScriptBoard"
            Grid.Row="1"
            Margin="0,3">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.65*" />
                <ColumnDefinition Width="0.005*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="10,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    x:Name="ScriptMenu"
                    Grid.Row="0"
                    Margin="0,0,0,5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.3*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        Orientation="Horizontal">
                        <ui:Button
                            Name="Script_SwitchBtn"
                            Width="20"
                            Height="20"
                            Margin="0,0,3,0"
                            Padding="0"
                            Background="Transparent"
                            Click="Menu_Click"
                            ToolTipService.InitialShowDelay="100"
                            ToolTipService.Placement="MousePoint">
                            <ui:Button.ToolTip>
                                <ToolTip Name="Script_SwitchTip" Content="Start Script" />
                            </ui:Button.ToolTip>
                            <ui:Button.Content>
                                <ui:SymbolIcon
                                    Name="Script_SwitchIcon"
                                    FontSize="16"
                                    Symbol="TriangleRight16" />
                            </ui:Button.Content>
                        </ui:Button>
                        <ui:Button
                            Name="Script_TempSwitchBtn"
                            Width="20"
                            Height="20"
                            Margin="0,0,3,0"
                            Padding="0"
                            Background="Transparent"
                            Click="Menu_Click"
                            ToolTipService.InitialShowDelay="100"
                            ToolTipService.Placement="MousePoint">
                            <ui:Button.ToolTip>
                                <ToolTip Name="Script_TempSwitchTip" Content="Pause Script" />
                            </ui:Button.ToolTip>
                            <ui:Button.Content>
                                <ui:SymbolIcon
                                    Name="Script_TempSwitchIcon"
                                    FontSize="16"
                                    Symbol="PauseOff16" />
                            </ui:Button.Content>
                        </ui:Button>
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <ui:Button
                            Name="Script_SearchBtn"
                            Width="20"
                            Height="20"
                            Margin="0,0,3,0"
                            Padding="0"
                            Background="Transparent"
                            Click="Menu_Click"
                            ToolTipService.InitialShowDelay="100"
                            ToolTipService.Placement="MousePoint"
                            Visibility="Collapsed">
                            <ui:Button.ToolTip>
                                <ToolTip Content="Search Codeline" />
                            </ui:Button.ToolTip>
                            <ui:Button.Content>
                                <ui:SymbolIcon FontSize="16" Symbol="Search16" />
                            </ui:Button.Content>
                        </ui:Button>
                        <ui:Button
                            Name="Script_ClearBtn"
                            Width="20"
                            Height="20"
                            Margin="0,0,3,0"
                            Padding="0"
                            Background="Transparent"
                            Click="Menu_Click"
                            ToolTipService.InitialShowDelay="100"
                            ToolTipService.Placement="MousePoint">
                            <ui:Button.ToolTip>
                                <ToolTip Content="Clear List" />
                            </ui:Button.ToolTip>
                            <ui:Button.Content>
                                <ui:SymbolIcon FontSize="16" Symbol="SlideEraser16" />
                            </ui:Button.Content>
                        </ui:Button>
                        <Rectangle
                            Width="0.5"
                            Height="20"
                            Margin="0,0,3,0"
                            Fill="#373640" />
                        <ui:Button
                            Name="Script_MoveUpBtn"
                            Width="20"
                            Height="20"
                            Margin="0,0,3,0"
                            Padding="0"
                            Background="Transparent"
                            Click="Menu_Click"
                            ToolTipService.InitialShowDelay="100"
                            ToolTipService.Placement="MousePoint">
                            <ui:Button.ToolTip>
                                <ToolTip Content="Move Selected Item(s) Up" />
                            </ui:Button.ToolTip>
                            <ui:Button.Content>
                                <ui:SymbolIcon FontSize="16" Symbol="ArrowUp16" />
                            </ui:Button.Content>
                        </ui:Button>
                        <ui:Button
                            Name="Script_MoveDownBtn"
                            Width="20"
                            Height="20"
                            Margin="0,0,3,0"
                            Padding="0"
                            Background="Transparent"
                            Click="Menu_Click"
                            ToolTipService.InitialShowDelay="100"
                            ToolTipService.Placement="MousePoint">
                            <ui:Button.ToolTip>
                                <ToolTip Content="Move Selected Item(s) Down" />
                            </ui:Button.ToolTip>
                            <ui:Button.Content>
                                <ui:SymbolIcon FontSize="16" Symbol="ArrowDown16" />
                            </ui:Button.Content>
                        </ui:Button>
                        <Rectangle
                            Width="0.5"
                            Height="20"
                            Margin="0,0,3,0"
                            Fill="#373640" />
                        <ui:Button
                            Name="Script_LoadBtn"
                            Width="20"
                            Height="20"
                            Margin="0,0,3,0"
                            Padding="0"
                            Background="Transparent"
                            Click="Menu_Click"
                            ToolTipService.InitialShowDelay="100"
                            ToolTipService.Placement="MousePoint">
                            <ui:Button.ToolTip>
                                <ToolTip Content="Load Script" />
                            </ui:Button.ToolTip>
                            <ui:Button.Content>
                                <ui:SymbolIcon FontSize="16" Symbol="FolderOpen16" />
                            </ui:Button.Content>
                        </ui:Button>
                        <ui:Button
                            Name="Script_SaveBtn"
                            Width="20"
                            Height="20"
                            Margin="0,0,3,0"
                            Padding="0"
                            Background="Transparent"
                            Click="Menu_Click"
                            ToolTipService.InitialShowDelay="100"
                            ToolTipService.Placement="MousePoint">
                            <ui:Button.ToolTip>
                                <ToolTip Content="Save Script" />
                            </ui:Button.ToolTip>
                            <ui:Button.Content>
                                <ui:SymbolIcon FontSize="16" Symbol="Save16" />
                            </ui:Button.Content>
                        </ui:Button>
                        <Rectangle
                            Width="0.5"
                            Height="20"
                            Margin="0,0,3,0"
                            Fill="#373640" />
                        <ui:Button
                            Name="Script_InfoBtn"
                            Width="20"
                            Height="20"
                            Margin="0,0,3,0"
                            Padding="0"
                            Background="Transparent"
                            Click="Menu_Click"
                            ToolTipService.InitialShowDelay="100"
                            ToolTipService.Placement="MousePoint">
                            <ui:Button.ToolTip>
                                <ToolTip Content="Script Info" />
                            </ui:Button.ToolTip>
                            <ui:Button.Content>
                                <ui:SymbolIcon FontSize="16" Symbol="Info16" />
                            </ui:Button.Content>
                        </ui:Button>
                        <ui:Button
                            Name="Script_NotesBtn"
                            Width="20"
                            Height="20"
                            Padding="0"
                            Background="Transparent"
                            Click="Menu_Click"
                            ToolTipService.InitialShowDelay="100"
                            ToolTipService.Placement="MousePoint">
                            <ui:Button.ToolTip>
                                <ToolTip Content="Important Tips" />
                            </ui:Button.ToolTip>
                            <ui:Button.Content>
                                <ui:SymbolIcon FontSize="16" Symbol="NotePin16" />
                            </ui:Button.Content>
                        </ui:Button>
                    </StackPanel>
                </Grid>
                <Border
                    x:Name="Script_EmptyBorder"
                    Grid.Row="1"
                    BorderBrush="#2b2a33"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="Collapsed">

                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource BDMerced}"
                        FontSize="16"
                        Opacity="0.75"
                        Text="List is empty" />
                </Border>
                <Border
                    x:Name="Script_ListBorder"
                    Grid.Row="1"
                    BorderBrush="#2b2a33"
                    BorderThickness="1"
                    CornerRadius="4"
                    Visibility="Visible">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ListView
                            x:Name="Script_List"
                            Grid.Row="0"
                            ScrollViewer.CanContentScroll="False"
                            SelectionChanged="CodelineItem_SelectionChanged"
                            SelectionMode="Single"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.ScrollUnit="Pixel" />
                        <Border
                            Grid.Row="1"
                            BorderBrush="#2b2a33"
                            BorderThickness="0,1,0,0">
                            <Grid x:Name="Script_ListedGrid" Height="36">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ui:Button
                                    Name="InternalCmds_ExitBtn"
                                    Width="24"
                                    Height="24"
                                    Margin="5,0,5,0"
                                    Padding="0"
                                    Background="Transparent"
                                    Click="InternalExit_Click">
                                    <ui:Button.Content>
                                        <ui:SymbolIcon FontSize="20" Symbol="ArrowExit20" />
                                    </ui:Button.Content>
                                </ui:Button>
                                <StackPanel
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Orientation="Vertical">
                                    <TextBlock
                                        Name="InternalCmds_MasterTxt"
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="Bold"
                                        Text="Lorem Ipsum" />
                                    <TextBlock
                                        Name="InternalCmds_TypeTxt"
                                        HorizontalAlignment="Center"
                                        FontSize="8"
                                        Opacity="0.5"
                                        Text="Statement Command" />
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border
                            Grid.Row="1"
                            BorderBrush="#2b2a33"
                            BorderThickness="0,1,0,0">
                            <ComboBox
                                x:Name="Script_StanceBox"
                                Grid.Row="1"
                                Background="Transparent"
                                IsEditable="True"
                                KeyDown="Stance_KeyDown"
                                SelectedValuePath="Label"
                                SelectionChanged="Stance_SelectionChanged"
                                TextElement.FontFamily="{StaticResource Poppins}"
                                TextElement.FontSize="12"
                                TextElement.FontWeight="SemiBold" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    Grid.Row="0"
                    Width="0.75"
                    Margin="0,5"
                    Background="#2b2a33" />
                <Border
                    Grid.Row="1"
                    Width="0.75"
                    Margin="0,5"
                    Background="#2b2a33" />
                <Border
                    Grid.Row="2"
                    Width="0.75"
                    Margin="0,5"
                    Background="#2b2a33" />
                <Border
                    Grid.Row="3"
                    Width="0.75"
                    Margin="0,5"
                    Background="#2b2a33" />
                <Border
                    Grid.Row="4"
                    Width="0.75"
                    Margin="0,5"
                    Background="#2b2a33" />
                <Border
                    Grid.Row="5"
                    Width="0.75"
                    Margin="0,5"
                    Background="#2b2a33" />
                <Border
                    Grid.Row="6"
                    Width="0.75"
                    Margin="0,5"
                    Background="#2b2a33" />
                <Border
                    Grid.Row="7"
                    Width="0.75"
                    Margin="0,5"
                    Background="#2b2a33" />
                <Border
                    Grid.Row="8"
                    Width="0.75"
                    Margin="0,5"
                    Background="#2b2a33" />
                <Border
                    Grid.Row="9"
                    Width="0.75"
                    Margin="0,5"
                    Background="#2b2a33" />
            </Grid>
            <Grid
                Name="Creator_CodelinePnl"
                Grid.Column="2"
                Margin="10,5"
                Visibility="Visible">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Margin="0,0,0,5"
                    Orientation="Horizontal">
                    <ui:SymbolIcon
                        FontSize="16"
                        Foreground="#fbfbfe"
                        Symbol="CodeText20" />
                    <TextBlock
                        Margin="5,0,0,0"
                        FontSize="12"
                        FontStyle="Italic"
                        FontWeight="Bold"
                        Text="Create Codeline" />
                </StackPanel>
                <Border
                    Grid.Row="1"
                    Height="68"
                    Background="#18171D"
                    BorderBrush="#0c0c0d"
                    BorderThickness="0.5"
                    CornerRadius="4">

                    <Grid Margin="10,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <Label
                                Content="Codeline Type"
                                FontSize="8"
                                FontStyle="Italic"
                                FontWeight="Medium"
                                Opacity="0.5" />
                            <Border BorderBrush="#2b2a33" BorderThickness="0,0,0,1">
                                <ComboBox
                                    Name="Creator_CodelineTypeBox"
                                    Background="Transparent"
                                    FontSize="12"
                                    IsEditable="True"
                                    IsTextSearchEnabled="True"
                                    SelectionChanged="CodelineBox_SelectionChanged" />
                            </Border>
                        </StackPanel>
                        <Border
                            Grid.Column="1"
                            Width="1"
                            Height="29"
                            Margin="15,0"
                            Background="#2b2a33"
                            CornerRadius="0.5" />
                        <StackPanel
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <Label
                                Content="Target Codeline"
                                FontSize="8"
                                FontStyle="Italic"
                                FontWeight="Medium"
                                Opacity="0.5" />
                            <Border BorderBrush="#2b2a33" BorderThickness="0,0,0,1">
                                <ComboBox
                                    Name="Creator_CodelineTargetBox"
                                    Background="Transparent"
                                    DisplayMemberPath="CommandName"
                                    FontSize="12"
                                    IsEditable="True"
                                    IsTextSearchEnabled="True"
                                    SelectionChanged="CodelineBox_SelectionChanged" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border
                    Grid.Row="2"
                    Margin="0,5"
                    Background="#18171D"
                    BorderBrush="#0c0c0d"
                    BorderThickness="0.5"
                    CornerRadius="4">

                    <Grid Name="Creator_CodelineView">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Grid.Row="0"
                            Margin="10,5"
                            Orientation="Vertical">

                            <TextBlock
                                Name="Creator_CodelinePositionTxt"
                                Margin="0,0,0,2.5"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Opacity="0.5"
                                Text="New" />
                            <TextBlock
                                Name="Creator_CodelineNameTxt"
                                VerticalAlignment="Bottom"
                                FontSize="12"
                                FontWeight="Bold"
                                Text="Action" />
                            <TextBlock
                                Name="Creator_CodelineDescTxt"
                                FontSize="10"
                                FontStyle="Italic"
                                Text="A script command that performs a single in-game action, accompanied either with a ruleset or without one."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Border
                            Grid.Row="1"
                            Height="1"
                            Margin="10,2.5,10,0"
                            Background="#2b2a33"
                            CornerRadius="0.5" />
                        <ui:DynamicScrollViewer
                            Name="Creator_PrmScroll"
                            Grid.Row="2"
                            Margin="10,2.5"
                            Padding="0,0,10,0"
                            ScrollViewer.CanContentScroll="False"
                            VirtualizingPanel.ScrollUnit="Pixel">

                            <StackPanel Orientation="Vertical">
                                <!--  Apparently making it Virtualized breaks the whole thing apart  -->
                                <Label
                                    Name="Creator_PrmLbl"
                                    Margin="0,5"
                                    Content="Parameters"
                                    FontSize="8"
                                    FontWeight="Bold"
                                    Opacity="0.25" />
                                <StackPanel Name="Creator_PrmList" Orientation="Vertical" />
                                <Label
                                    Name="Creator_OptedPrmLbl"
                                    Margin="0,5"
                                    Content="Opted Parameters"
                                    FontSize="8"
                                    FontWeight="Bold"
                                    Opacity="0.25"
                                    Visibility="Visible" />
                                <StackPanel Name="Creator_OptedPrmList" Orientation="Vertical" />
                                <Label
                                    Name="Creator_MoreOptedPrmLbl"
                                    Margin="0,5"
                                    HorizontalAlignment="Right"
                                    Content="Add more parameters:"
                                    FontSize="8"
                                    FontWeight="Bold"
                                    Opacity="0.25"
                                    Visibility="Visible" />
                                <StackPanel
                                    Name="Creator_MoreOptedPrmPanel"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                                    <ComboBox
                                        Name="Creator_MoreOptedPrmBox"
                                        Width="150"
                                        Background="Transparent"
                                        FontSize="12"
                                        IsTextSearchEnabled="True" />
                                    <ui:Button
                                        Name="Creator_MoreOptedPrmBtn"
                                        Width="24"
                                        Height="24"
                                        Margin="5,0,0,0"
                                        Padding="0"
                                        Background="Transparent"
                                        Click="CodelineMenu_Click">
                                        <ui:Button.Content>
                                            <ui:SymbolIcon FontSize="20" Symbol="Add16" />
                                        </ui:Button.Content>
                                    </ui:Button>
                                </StackPanel>
                            </StackPanel>
                        </ui:DynamicScrollViewer>
                    </Grid>
                </Border>
                <Grid Name="Creator_CodelineMenu" Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.5*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        Orientation="Horizontal">
                        <ui:Button
                            Name="Creator_ClearPrmBtn"
                            Width="24"
                            Height="24"
                            Margin="0,0,3,0"
                            Padding="0"
                            Background="Transparent"
                            Click="CodelineMenu_Click"
                            ToolTipService.InitialShowDelay="100"
                            ToolTipService.Placement="MousePoint">
                            <ui:Button.ToolTip>
                                <ToolTip Content="Clear Parameters" />
                            </ui:Button.ToolTip>
                            <ui:Button.Content>
                                <ui:SymbolIcon FontSize="20" Symbol="Eraser20" />
                            </ui:Button.Content>
                        </ui:Button>
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <ui:Button
                            Name="Creator_CodelineInfoBtn"
                            Width="24"
                            Height="24"
                            Margin="0,0,6,0"
                            Padding="0"
                            Background="Transparent"
                            Click="CodelineMenu_Click"
                            ToolTipService.InitialShowDelay="100"
                            ToolTipService.Placement="MousePoint">
                            <ui:Button.ToolTip>
                                <ToolTip Content="Codeline Info" />
                            </ui:Button.ToolTip>
                            <ui:Button.Content>
                                <ui:SymbolIcon FontSize="20" Symbol="LightbulbCircle20" />
                            </ui:Button.Content>
                        </ui:Button>
                        <ui:Button
                            Name="Creator_CodelineAddBtn"
                            Background="#2b2a33"
                            BorderBrush="#0c0c0d"
                            BorderThickness="1"
                            Click="CodelineMenu_Click"
                            Content="Add Codeline"
                            FontSize="12"
                            FontWeight="Medium" />
                    </StackPanel>
                </Grid>
            </Grid>
            <Grid
                Name="Editor_CodelinePnl"
                Grid.Column="2"
                Margin="10,5"
                Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel
                    Grid.Row="0"
                    Margin="0,0,0,5"
                    Orientation="Horizontal">
                    <ui:Button
                        Name="Editor_ReturnBtn"
                        Width="20"
                        Height="20"
                        Margin="0,0,5,0"
                        Padding="0"
                        Background="Transparent"
                        Click="Return_Click">
                        <ui:Button.Content>
                            <ui:SymbolIcon FontSize="16" Symbol="ArrowCircleLeft16" />
                        </ui:Button.Content>
                    </ui:Button>
                    <ui:SymbolIcon
                        FontSize="16"
                        Foreground="#fbfbfe"
                        Symbol="CodeText20" />
                    <TextBlock
                        Margin="5,0,0,0"
                        FontSize="12"
                        FontStyle="Italic"
                        FontWeight="Bold"
                        Text="Edit Codeline" />
                </StackPanel>
                <Border
                    Grid.Row="1"
                    Height="68"
                    Background="#18171D"
                    BorderBrush="#0c0c0d"
                    BorderThickness="0.5"
                    CornerRadius="4"
                    Visibility="Collapsed">

                    <Grid Margin="10,5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <Label
                                Content="Codeline Type"
                                FontSize="8"
                                FontStyle="Italic"
                                FontWeight="Medium"
                                Opacity="0.5" />
                            <Border BorderBrush="#2b2a33" BorderThickness="0,0,0,1">
                                <ComboBox
                                    Name="Editor_CodelineTypeBox"
                                    Background="Transparent"
                                    FontSize="12"
                                    IsEnabled="False"
                                    SelectionChanged="CodelineBox_SelectionChanged" />
                            </Border>
                        </StackPanel>
                        <Border
                            Grid.Column="1"
                            Width="1"
                            Height="29"
                            Margin="15,0"
                            Background="#2b2a33"
                            CornerRadius="0.5" />
                        <StackPanel
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            Orientation="Vertical">
                            <Label
                                Content="Target Codeline"
                                FontSize="8"
                                FontStyle="Italic"
                                FontWeight="Medium"
                                Opacity="0.5" />
                            <Border BorderBrush="#2b2a33" BorderThickness="0,0,0,1">
                                <ComboBox
                                    Name="Editor_CodelineTargetBox"
                                    Background="Transparent"
                                    FontSize="12"
                                    IsEnabled="False"
                                    SelectionChanged="CodelineBox_SelectionChanged" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border
                    Grid.Row="2"
                    Margin="0,5"
                    Background="#18171D"
                    BorderBrush="#0c0c0d"
                    BorderThickness="0.5"
                    CornerRadius="4">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <StackPanel
                            Grid.Row="0"
                            Margin="10,5"
                            Orientation="Vertical">

                            <TextBlock
                                Name="Editor_CodelinePositionTxt"
                                Margin="0,0,0,2.5"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Opacity="0.5"
                                Text="Script Command | Index 0" />
                            <TextBlock
                                Name="Editor_CodelineNameTxt"
                                VerticalAlignment="Bottom"
                                FontSize="12"
                                FontWeight="Bold"
                                Text="Action" />
                            <TextBlock
                                Name="Editor_CodelineDescTxt"
                                FontSize="10"
                                FontStyle="Italic"
                                Text="A script command that performs a single in-game action, accompanied either with a ruleset or without one."
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Border
                            Grid.Row="1"
                            Height="1"
                            Margin="10,2.5,10,0"
                            Background="#2b2a33"
                            CornerRadius="0.5" />
                        <ui:DynamicScrollViewer
                            Name="Editor_PrmScroll"
                            Grid.Row="2"
                            Margin="10,2.5"
                            Padding="0,0,10,0"
                            ScrollViewer.CanContentScroll="True"
                            VirtualizingPanel.ScrollUnit="Pixel">

                            <StackPanel>
                                <!--  Virtualizing version doesn't work  -->
                                <Label
                                    Name="Editor_PrmLbl"
                                    Margin="0,5"
                                    Content="Parameters"
                                    FontSize="8"
                                    FontWeight="Bold"
                                    Opacity="0.25" />
                                <StackPanel Name="Editor_PrmList" Orientation="Vertical" />
                                <Label
                                    Name="Editor_OptedPrmLbl"
                                    Margin="0,5"
                                    Content="Opted Parameters"
                                    FontSize="8"
                                    FontWeight="Bold"
                                    Opacity="0.25"
                                    Visibility="Visible" />
                                <StackPanel Name="Editor_OptedPrmList" Orientation="Vertical" />
                                <Label
                                    Name="Editor_MoreOptedPrmLbl"
                                    Margin="0,5"
                                    HorizontalAlignment="Right"
                                    Content="Add more parameters:"
                                    FontSize="8"
                                    FontWeight="Bold"
                                    Opacity="0.25"
                                    Visibility="Visible" />
                                <StackPanel
                                    Name="Editor_MoreOptedPrmPanel"
                                    HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                                    <ComboBox
                                        Name="Editor_MoreOptedPrmBox"
                                        Width="150"
                                        Background="Transparent"
                                        FontSize="12"
                                        IsTextSearchEnabled="True" />
                                    <ui:Button
                                        Name="Editor_MoreOptedPrmBtn"
                                        Width="24"
                                        Height="24"
                                        Margin="5,0,0,0"
                                        Padding="0"
                                        Background="Transparent"
                                        Click="CodelineMenu_Click">
                                        <ui:Button.Content>
                                            <ui:SymbolIcon FontSize="20" Symbol="Add16" />
                                        </ui:Button.Content>
                                    </ui:Button>
                                </StackPanel>
                            </StackPanel>
                        </ui:DynamicScrollViewer>
                    </Grid>
                </Border>
                <Grid Name="Editor_CodelineMenu" Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.5*" />
                        <ColumnDefinition Width="1*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel
                        Grid.Column="0"
                        HorizontalAlignment="Left"
                        Orientation="Horizontal">
                        <ui:Button
                            Name="Editor_ClearPrmBtn"
                            Width="24"
                            Height="24"
                            Margin="0,0,3,0"
                            Padding="0"
                            Background="Transparent"
                            Click="CodelineMenu_Click"
                            ToolTipService.InitialShowDelay="100"
                            ToolTipService.Placement="MousePoint">
                            <ui:Button.ToolTip>
                                <ToolTip Content="Clear Parameters" />
                            </ui:Button.ToolTip>
                            <ui:Button.Content>
                                <ui:SymbolIcon FontSize="20" Symbol="Eraser20" />
                            </ui:Button.Content>
                        </ui:Button>
                    </StackPanel>
                    <StackPanel
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal">
                        <ui:Button
                            Name="Editor_CodelineInfoBtn"
                            Width="24"
                            Height="24"
                            Margin="0,0,6,0"
                            Padding="0"
                            Background="Transparent"
                            Click="CodelineMenu_Click"
                            ToolTipService.InitialShowDelay="100"
                            ToolTipService.Placement="MousePoint">
                            <ui:Button.ToolTip>
                                <ToolTip Content="Codeline Info" />
                            </ui:Button.ToolTip>
                            <ui:Button.Content>
                                <ui:SymbolIcon FontSize="20" Symbol="LightbulbCircle20" />
                            </ui:Button.Content>
                        </ui:Button>
                        <ui:Button
                            Name="Editor_CodelineRemBtn"
                            Background="#2b2a33"
                            BorderBrush="#0c0c0d"
                            BorderThickness="1"
                            Click="CodelineMenu_Click"
                            Content="Remove Codeline"
                            FontSize="12"
                            FontWeight="Medium" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Grid>
    </Grid>

</UserControl>
