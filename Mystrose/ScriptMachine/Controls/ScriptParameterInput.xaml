<UserControl
    x:Class="Mystrose.ScriptMachine.ScriptParameterInput"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Mystrose.ScriptMachine"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="55"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <Grid Margin="0,0,0,7.5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel
            Grid.Row="0"
            Opacity="0.5"
            Orientation="Horizontal">
            <TextBlock
                Name="NameBlock"
                Margin="0,0.5,2.5,0"
                Padding="0"
                FontSize="10"
                FontWeight="SemiBold"
                Text="Name" />
            <ui:Button
                Name="TooltipBtn"
                Width="20"
                Height="16"
                Padding="0"
                Background="Transparent"
                MouseOverBackground="Transparent"
                PressedBackground="Transparent"
                ToolTipService.InitialShowDelay="100"
                ToolTipService.Placement="MousePoint">

                <ui:Button.ToolTip>
                    <ToolTip Name="TooltipLbl" Content="Tooltip" />
                </ui:Button.ToolTip>
                <ui:Button.Content>
                    <ui:SymbolIcon FontSize="12" Symbol="QuestionCircle20" />
                </ui:Button.Content>
            </ui:Button>
        </StackPanel>
        <Grid Name="InputGrid" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border
                Name="InputCbBdr"
                Grid.Column="0"
                Margin="0,0,5,0"
                BorderBrush="#2b2a33"
                BorderThickness="0,0,0,1"
                Visibility="Collapsed">
                <ComboBox
                    Name="InputCb"
                    Background="Transparent"
                    FontSize="10"
                    IsEditable="True"
                    SelectionChanged="Input_SelectionChanged" />
            </Border>
            <Border
                Name="InputLblBdr"
                Grid.Column="0"
                Margin="0,0,5,0"
                BorderBrush="#2b2a33"
                BorderThickness="0,0,0,1"
                Visibility="Collapsed">
                <ui:TextBox
                    Name="InputLbl"
                    Background="Transparent"
                    FontSize="10"
                    TextChanged="Input_TextChanged" />
            </Border>

            <Border
                Name="InputOptBdr"
                Grid.Column="1"
                BorderBrush="#2b2a33"
                BorderThickness="0,0,0,1"
                Visibility="Collapsed">
                <ComboBox
                    Name="InputOpt"
                    Background="Transparent"
                    FontSize="10"
                    IsEditable="True"
                    SelectionChanged="Input_SelectionChanged" />
            </Border>
            <Border
                Name="InputTxtBdr"
                Grid.Column="1"
                BorderBrush="#2b2a33"
                BorderThickness="0,0,0,1"
                Visibility="Collapsed">
                <ui:TextBox
                    Name="InputTxt"
                    Background="Transparent"
                    FontSize="10"
                    TextChanged="Input_TextChanged" />
            </Border>
        </Grid>
    </Grid>
</UserControl>
