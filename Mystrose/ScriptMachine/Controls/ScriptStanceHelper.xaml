<UserControl
    x:Class="Mystrose.ScriptMachine.Controls.ScriptStanceHelper"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Mystrose.ScriptMachine.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="24"
    d:DesignWidth="300"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <ui:TextBox
            Name="BoxStanceName"
            Grid.Column="0"
            Padding="6,2"
            FontFamily="{StaticResource Poppins}"
            FontSize="12"
            Foreground="#FFFFFF"
            PlaceholderText="Enter a stance label.." />
        <StackPanel
            Grid.Column="1"
            Margin="6,0,0,0"
            Orientation="Horizontal">
            <ui:Button
                Name="BtnAdd"
                Width="18"
                Height="18"
                Padding="0"
                Background="Transparent"
                Click="OnBtnAdd_Click">
                <ui:Button.Content>
                    <ui:SymbolIcon
                        Margin="0.5"
                        FontSize="12"
                        Foreground="LightGreen"
                        Symbol="Add12" />
                </ui:Button.Content>
            </ui:Button>
        </StackPanel>
    </Grid>
</UserControl>
