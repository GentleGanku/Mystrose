<UserControl
    x:Class="Mystrose.ScriptMachine.ScriptCodelineItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Mystrose.ScriptMachine"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="50"
    d:DesignWidth="400"
    MouseDoubleClick="Item_DoubleClick"
    MouseEnter="Item_MouseEnter"
    MouseLeave="Item_MouseLeave"
    mc:Ignorable="d">

    <StackPanel Orientation="Vertical">
        <Grid Margin="5,2.5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Name="IndexTxt"
                Grid.Column="0"
                Width="30"
                Padding="0,1,5,0"
                FontFamily="{StaticResource Poppins}"
                FontSize="10"
                FontWeight="SemiBold"
                Foreground="#80b9ee"
                Text="[100]" />
            <StackPanel Grid.Column="1" Orientation="Vertical">
                <TextBlock
                    Name="LabelTxt"
                    Padding="5,0,0,0"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Text="Attack"
                    TextWrapping="Wrap" />
                <TextBlock
                    Name="InternalCommandsTxt"
                    Padding="5,0,0,0"
                    FontSize="12"
                    FontStyle="Italic"
                    FontWeight="SemiBold"
                    Opacity="0.5"
                    Text="0 internal commands"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Grid>
    </StackPanel>
</UserControl>
