<UserControl
    x:Class="Mystrose.ScriptMachine.ScriptCodelineItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Mystrose.ScriptMachine"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="50"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <StackPanel Margin="2.5" Orientation="Vertical">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Name="IndexTxt"
                Grid.Column="0"
                Width="30"
                Padding="0,1,5,0"
                FontFamily="{StaticResource Poppins}"
                FontSize="10"
                FontWeight="SemiBold"
                Foreground="DodgerBlue"
                Text="[100]" />
            <TextBlock
                Name="LabelTxt"
                Grid.Column="1"
                Padding="5,0,0,0"
                FontSize="12"
                FontWeight="SemiBold"
                Text="Attack"
                TextWrapping="Wrap" />
        </Grid>
        <VirtualizingStackPanel
            Name="CommandsPnl"
            Margin="30,2.5,0,0"
            Opacity="0.5"
            Orientation="Vertical"
            Visibility="Collapsed">
            <TextBlock
                Padding="0"
                FontSize="12"
                FontStyle="Italic"
                FontWeight="SemiBold"
                Text="Commands" />
            <ListView Name="CommandsLst" />
        </VirtualizingStackPanel>
    </StackPanel>
</UserControl>
