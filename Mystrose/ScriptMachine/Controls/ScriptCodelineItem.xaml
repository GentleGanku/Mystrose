<UserControl
    x:Class="Mystrose.ScriptMachine.ScriptCodelineItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Mystrose.ScriptMachine"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="50"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <Grid Margin="2.5">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock
                Name="IndexTxt"
                Width="30"
                Padding="0,0.5,5,0"
                FontFamily="{StaticResource Poppins}"
                FontSize="8"
                FontWeight="SemiBold"
                Foreground="#559ce4"
                Text="[100]" />
            <TextBlock
                Name="LabelTxt"
                Padding="0"
                FontSize="10"
                FontWeight="SemiBold"
                Text="Attack"
                TextWrapping="Wrap" />
        </StackPanel>
        <VirtualizingStackPanel
            Name="CommandsPnl"
            Grid.Row="1"
            Margin="30,2.5,0,0"
            Opacity="0.5"
            Orientation="Vertical"
            Visibility="Collapsed">
            <TextBlock
                Padding="0"
                FontSize="12"
                FontStyle="Italic"
                FontWeight="SemiBold"
                Text="Commands" />
            <ListView Name="CommandsLst" />
        </VirtualizingStackPanel>
    </Grid>
</UserControl>
