<UserControl
    x:Class="Mystrose.Core.ScriptMachine.Panels.Controls.ScriptParameterInput"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="55"
    d:DesignWidth="400"
    mc:Ignorable="d">

    <StackPanel Margin="0,0,0,7.5">
        <Grid Opacity="0.5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ui:Button
                Name="TooltipBtn"
                Grid.Column="0"
                Width="20"
                Height="16"
                Padding="0"
                Background="Transparent"
                MouseOverBackground="Transparent"
                PressedBackground="Transparent"
                ToolTipService.InitialShowDelay="100"
                ToolTipService.Placement="MousePoint">

                <ui:Button.ToolTip>
                    <ToolTip Name="TooltipLbl" Content="Tooltip" />
                </ui:Button.ToolTip>
                <ui:Button.Content>
                    <ui:SymbolIcon FontSize="12" Symbol="QuestionCircle20" />
                </ui:Button.Content>
            </ui:Button>
            <TextBlock
                Name="NameBlock"
                Grid.Column="1"
                Margin="2.5,0.5,0,0"
                Padding="0"
                FontSize="10"
                FontWeight="SemiBold"
                Text="Name" />
            <ui:Button
                Name="RemoveBtn"
                Grid.Column="2"
                Width="16"
                Height="16"
                Padding="0"
                HorizontalAlignment="Right"
                Background="Transparent"
                Click="Btn_Click"
                MouseOverBackground="Transparent"
                PressedBackground="Transparent"
                ToolTipService.InitialShowDelay="100"
                ToolTipService.Placement="MousePoint"
                Visibility="Collapsed">

                <ui:Button.ToolTip>
                    <ToolTip Name="RemoveLbl" Content="Remove the parameter" />
                </ui:Button.ToolTip>
                <ui:Button.Content>
                    <ui:SymbolIcon FontSize="12" Symbol="Delete16" />
                </ui:Button.Content>
            </ui:Button>
        </Grid>
        <Grid Name="InputGrid">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border
                Name="InputCbBdr"
                Grid.Column="0"
                Margin="0,0,5,0"
                BorderBrush="#2b2a33"
                BorderThickness="0,0,0,1"
                Visibility="Collapsed">
                <ComboBox
                    Name="InputCb"
                    Background="Transparent"
                    FontSize="10"
                    IsTextSearchEnabled="True"
                    SelectionChanged="Input_SelectionChanged" />
            </Border>
            <Border
                Name="InputLblBdr"
                Grid.Column="0"
                Margin="0,0,5,0"
                BorderBrush="#2b2a33"
                BorderThickness="0,0,0,1"
                Visibility="Collapsed">
                <ui:TextBox
                    Name="InputLbl"
                    Background="Transparent"
                    FontSize="10"
                    PlaceholderText="Input a corresponding value..."
                    TextChanged="Input_TextChanged" />
            </Border>

            <Border
                Name="InputOptBdr"
                Grid.Column="1"
                BorderBrush="#2b2a33"
                BorderThickness="0,0,0,1"
                Visibility="Collapsed">
                <ComboBox
                    Name="InputOpt"
                    Background="Transparent"
                    FontSize="10"
                    IsTextSearchEnabled="True"
                    SelectionChanged="Input_SelectionChanged" />
            </Border>
            <Border
                Name="InputTxtBdr"
                Grid.Column="1"
                BorderBrush="#2b2a33"
                BorderThickness="0,0,0,1"
                Visibility="Collapsed">
                <ui:TextBox
                    Name="InputTxt"
                    Background="Transparent"
                    FontSize="10"
                    PlaceholderText="Input a corresponding value..."
                    TextChanged="Input_TextChanged" />
            </Border>
        </Grid>
    </StackPanel>
</UserControl>
