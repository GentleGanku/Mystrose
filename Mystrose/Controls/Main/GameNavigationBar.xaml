<UserControl
    x:Class="Mystrose.Controls.Main.GameNavigationBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:Mystrose.Controls.Main"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    MinWidth="160"
    MinHeight="40"
    d:DesignHeight="40"
    d:DesignWidth="959"
    mc:Ignorable="d">

    <Grid Height="40" Background="{DynamicResource ControlBarFillColorSecondaryBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <VirtualizingStackPanel
            Grid.Column="0"
            Margin="3"
            HorizontalAlignment="Left"
            Orientation="Horizontal">
            <ui:Button
                x:Name="AboutBtn"
                Width="32"
                Height="32"
                Margin="0,0,3,0"
                Padding="7,0,0,0"
                HorizontalContentAlignment="Left"
                Background="Transparent">
                <VirtualizingStackPanel Orientation="Horizontal">
                    <Image
                        Width="16"
                        Height="16"
                        Source="{StaticResource RoseIcon}" />
                    <TextBlock
                        Name="AboutTxt"
                        Width="0"
                        Height="16"
                        Padding="5,0"
                        HorizontalAlignment="Left"
                        FontSize="11"
                        Opacity="0">
                        About
                    </TextBlock>
                </VirtualizingStackPanel>

                <ui:Button.Triggers>
                    <EventTrigger RoutedEvent="Button.MouseEnter" SourceName="AboutBtn">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetName="AboutBtn"
                                    Storyboard.TargetProperty="Width"
                                    From="32"
                                    To="68"
                                    Duration="00:00:00.15" />
                                <DoubleAnimation
                                    Storyboard.TargetName="AboutTxt"
                                    Storyboard.TargetProperty="Width"
                                    From="0"
                                    To="36"
                                    Duration="00:00:00.15" />
                                <DoubleAnimation
                                    Storyboard.TargetName="AboutTxt"
                                    Storyboard.TargetProperty="Opacity"
                                    From="0"
                                    To="1"
                                    Duration="00:00:00.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="Button.MouseLeave" SourceName="AboutBtn">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetName="AboutBtn"
                                    Storyboard.TargetProperty="Width"
                                    From="68"
                                    To="32"
                                    Duration="00:00:00.15" />
                                <DoubleAnimation
                                    Storyboard.TargetName="AboutTxt"
                                    Storyboard.TargetProperty="Width"
                                    From="36"
                                    To="0"
                                    Duration="00:00:00.15" />
                                <DoubleAnimation
                                    Storyboard.TargetName="AboutTxt"
                                    Storyboard.TargetProperty="Opacity"
                                    From="1"
                                    To="0"
                                    Duration="00:00:00.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </ui:Button.Triggers>
            </ui:Button>
            <ui:Button
                x:Name="ScriptMngrBtn"
                Width="32"
                Height="32"
                Margin="0,0,3,0"
                Padding="7,0,0,0"
                HorizontalContentAlignment="Left"
                Background="Transparent"
                Click="OnButtonClick">
                <!--
                    MouseOverBackground="{DynamicResource ControlFillColorSecondaryBrush}"
                    PressedBackground="{DynamicResource ControlFillColorTertiaryBrush}"
                -->
                <VirtualizingStackPanel Orientation="Horizontal">
                    <iconPacks:PackIconSimpleIcons Kind="PureScript" />
                    <TextBlock
                        Name="ScriptMngrTxt"
                        Width="0"
                        Height="16"
                        Padding="5,0"
                        HorizontalAlignment="Left"
                        FontSize="11"
                        Opacity="0">
                        Script Manager
                    </TextBlock>
                </VirtualizingStackPanel>

                <ui:Button.Triggers>
                    <EventTrigger RoutedEvent="Button.MouseEnter" SourceName="ScriptMngrBtn">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetName="ScriptMngrBtn"
                                    Storyboard.TargetProperty="Width"
                                    From="32"
                                    To="112"
                                    Duration="00:00:00.15" />
                                <DoubleAnimation
                                    Storyboard.TargetName="ScriptMngrTxt"
                                    Storyboard.TargetProperty="Width"
                                    From="0"
                                    To="80"
                                    Duration="00:00:00.15" />
                                <DoubleAnimation
                                    Storyboard.TargetName="ScriptMngrTxt"
                                    Storyboard.TargetProperty="Opacity"
                                    From="0"
                                    To="1"
                                    Duration="00:00:00.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="Button.MouseLeave" SourceName="ScriptMngrBtn">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetName="ScriptMngrBtn"
                                    Storyboard.TargetProperty="Width"
                                    From="112"
                                    To="32"
                                    Duration="00:00:00.15" />
                                <DoubleAnimation
                                    Storyboard.TargetName="ScriptMngrTxt"
                                    Storyboard.TargetProperty="Width"
                                    From="80"
                                    To="0"
                                    Duration="00:00:00.15" />
                                <DoubleAnimation
                                    Storyboard.TargetName="ScriptMngrTxt"
                                    Storyboard.TargetProperty="Opacity"
                                    From="1"
                                    To="0"
                                    Duration="00:00:00.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </ui:Button.Triggers>
            </ui:Button>
            <ui:Button
                x:Name="CombatMngrBtn"
                Width="32"
                Height="32"
                Margin="0,0,3,0"
                Padding="7,0,0,0"
                HorizontalContentAlignment="Left"
                Background="Transparent"
                Click="OnButtonClick">
                <VirtualizingStackPanel Orientation="Horizontal">
                    <ui:SymbolIcon Symbol="TargetArrow16" />
                    <TextBlock
                        Name="CombatMngrTxt"
                        Width="0"
                        Height="16"
                        Padding="5,0"
                        HorizontalAlignment="Left"
                        FontSize="11"
                        Opacity="0">
                        Combat Manager
                    </TextBlock>
                </VirtualizingStackPanel>

                <ui:Button.Triggers>
                    <EventTrigger RoutedEvent="Button.MouseEnter" SourceName="CombatMngrBtn">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetName="CombatMngrBtn"
                                    Storyboard.TargetProperty="Width"
                                    From="32"
                                    To="123"
                                    Duration="00:00:00.15" />
                                <DoubleAnimation
                                    Storyboard.TargetName="CombatMngrTxt"
                                    Storyboard.TargetProperty="Width"
                                    From="0"
                                    To="91"
                                    Duration="00:00:00.15" />
                                <DoubleAnimation
                                    Storyboard.TargetName="CombatMngrTxt"
                                    Storyboard.TargetProperty="Opacity"
                                    From="0"
                                    To="1"
                                    Duration="00:00:00.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="Button.MouseLeave" SourceName="CombatMngrBtn">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetName="CombatMngrBtn"
                                    Storyboard.TargetProperty="Width"
                                    From="123"
                                    To="32"
                                    Duration="00:00:00.15" />
                                <DoubleAnimation
                                    Storyboard.TargetName="CombatMngrTxt"
                                    Storyboard.TargetProperty="Width"
                                    From="91"
                                    To="0"
                                    Duration="00:00:00.15" />
                                <DoubleAnimation
                                    Storyboard.TargetName="CombatMngrTxt"
                                    Storyboard.TargetProperty="Opacity"
                                    From="1"
                                    To="0"
                                    Duration="00:00:00.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </ui:Button.Triggers>
            </ui:Button>
            <ui:Button
                x:Name="MultiboxBtn"
                Width="32"
                Height="32"
                Margin="0,0,3,0"
                Padding="7,0,0,0"
                HorizontalContentAlignment="Left"
                Background="Transparent">
                <VirtualizingStackPanel Orientation="Horizontal">
                    <iconPacks:PackIconFeatherIcons Kind="Codesandbox" />
                    <TextBlock
                        Name="MultiboxTxt"
                        Width="0"
                        Height="16"
                        Padding="5,0"
                        HorizontalAlignment="Left"
                        FontSize="11"
                        Opacity="0">
                        Multibox
                    </TextBlock>
                </VirtualizingStackPanel>

                <ui:Button.Triggers>
                    <EventTrigger RoutedEvent="Button.MouseEnter" SourceName="MultiboxBtn">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetName="MultiboxBtn"
                                    Storyboard.TargetProperty="Width"
                                    From="32"
                                    To="81"
                                    Duration="00:00:00.15" />
                                <DoubleAnimation
                                    Storyboard.TargetName="MultiboxTxt"
                                    Storyboard.TargetProperty="Width"
                                    From="0"
                                    To="49"
                                    Duration="00:00:00.15" />
                                <DoubleAnimation
                                    Storyboard.TargetName="MultiboxTxt"
                                    Storyboard.TargetProperty="Opacity"
                                    From="0"
                                    To="1"
                                    Duration="00:00:00.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="Button.MouseLeave" SourceName="MultiboxBtn">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetName="MultiboxBtn"
                                    Storyboard.TargetProperty="Width"
                                    From="81"
                                    To="32"
                                    Duration="00:00:00.15" />
                                <DoubleAnimation
                                    Storyboard.TargetName="MultiboxTxt"
                                    Storyboard.TargetProperty="Width"
                                    From="49"
                                    To="0"
                                    Duration="00:00:00.15" />
                                <DoubleAnimation
                                    Storyboard.TargetName="MultiboxTxt"
                                    Storyboard.TargetProperty="Opacity"
                                    From="1"
                                    To="0"
                                    Duration="00:00:00.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </ui:Button.Triggers>
            </ui:Button>
            <ui:Button
                x:Name="ToolsBtn"
                Width="32"
                Height="32"
                Margin="0,0,3,0"
                Padding="7,0,0,0"
                HorizontalContentAlignment="Left"
                Background="Transparent">
                <VirtualizingStackPanel Orientation="Horizontal">
                    <iconPacks:PackIconForkAwesome Kind="Tasks" />
                    <TextBlock
                        Name="ToolsTxt"
                        Width="0"
                        Height="16"
                        Padding="5,0"
                        HorizontalAlignment="Left"
                        FontSize="11"
                        Opacity="0">
                        Tools
                    </TextBlock>
                </VirtualizingStackPanel>

                <ui:Button.Triggers>
                    <EventTrigger RoutedEvent="Button.MouseEnter" SourceName="ToolsBtn">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetName="ToolsBtn"
                                    Storyboard.TargetProperty="Width"
                                    From="32"
                                    To="62"
                                    Duration="00:00:00.15" />
                                <DoubleAnimation
                                    Storyboard.TargetName="ToolsTxt"
                                    Storyboard.TargetProperty="Width"
                                    From="0"
                                    To="30"
                                    Duration="00:00:00.15" />
                                <DoubleAnimation
                                    Storyboard.TargetName="ToolsTxt"
                                    Storyboard.TargetProperty="Opacity"
                                    From="0"
                                    To="1"
                                    Duration="00:00:00.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="Button.MouseLeave" SourceName="ToolsBtn">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetName="ToolsBtn"
                                    Storyboard.TargetProperty="Width"
                                    From="62"
                                    To="32"
                                    Duration="00:00:00.15" />
                                <DoubleAnimation
                                    Storyboard.TargetName="ToolsTxt"
                                    Storyboard.TargetProperty="Width"
                                    From="30"
                                    To="0"
                                    Duration="00:00:00.15" />
                                <DoubleAnimation
                                    Storyboard.TargetName="ToolsTxt"
                                    Storyboard.TargetProperty="Opacity"
                                    From="1"
                                    To="0"
                                    Duration="00:00:00.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </ui:Button.Triggers>
            </ui:Button>
            <ui:Button
                x:Name="ExtensionsBtn"
                Width="32"
                Height="32"
                Margin="0,0,3,0"
                Padding="7,0,0,0"
                HorizontalContentAlignment="Left"
                Background="Transparent">
                <VirtualizingStackPanel Orientation="Horizontal">
                    <iconPacks:PackIconCodicons Kind="Extensions" />
                    <TextBlock
                        Name="ExtensionsTxt"
                        Width="0"
                        Height="16"
                        Padding="5,0"
                        HorizontalAlignment="Left"
                        FontSize="11"
                        Opacity="0">
                        Extensions
                    </TextBlock>
                </VirtualizingStackPanel>

                <ui:Button.Triggers>
                    <EventTrigger RoutedEvent="Button.MouseEnter" SourceName="ExtensionsBtn">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetName="ExtensionsBtn"
                                    Storyboard.TargetProperty="Width"
                                    From="32"
                                    To="88"
                                    Duration="00:00:00.15" />
                                <DoubleAnimation
                                    Storyboard.TargetName="ExtensionsTxt"
                                    Storyboard.TargetProperty="Width"
                                    From="0"
                                    To="56"
                                    Duration="00:00:00.15" />
                                <DoubleAnimation
                                    Storyboard.TargetName="ExtensionsTxt"
                                    Storyboard.TargetProperty="Opacity"
                                    From="0"
                                    To="1"
                                    Duration="00:00:00.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="Button.MouseLeave" SourceName="ExtensionsBtn">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetName="ExtensionsBtn"
                                    Storyboard.TargetProperty="Width"
                                    From="88"
                                    To="32"
                                    Duration="00:00:00.15" />
                                <DoubleAnimation
                                    Storyboard.TargetName="ExtensionsTxt"
                                    Storyboard.TargetProperty="Width"
                                    From="56"
                                    To="0"
                                    Duration="00:00:00.15" />
                                <DoubleAnimation
                                    Storyboard.TargetName="ExtensionsTxt"
                                    Storyboard.TargetProperty="Opacity"
                                    From="1"
                                    To="0"
                                    Duration="00:00:00.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </ui:Button.Triggers>
            </ui:Button>
            <ui:Button
                x:Name="SettingsBtn"
                Width="32"
                Height="32"
                Margin="0,0,3,0"
                Padding="7,0,0,0"
                HorizontalContentAlignment="Left"
                Background="Transparent">
                <VirtualizingStackPanel Orientation="Horizontal">
                    <iconPacks:PackIconIonicons Kind="CogiOS" />
                    <TextBlock
                        Name="SettingsTxt"
                        Width="0"
                        Height="16"
                        Padding="5,0"
                        HorizontalAlignment="Left"
                        FontSize="11"
                        Opacity="0">
                        Settings
                    </TextBlock>
                </VirtualizingStackPanel>

                <ui:Button.Triggers>
                    <EventTrigger RoutedEvent="Button.MouseEnter" SourceName="SettingsBtn">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetName="SettingsBtn"
                                    Storyboard.TargetProperty="Width"
                                    From="32"
                                    To="76"
                                    Duration="00:00:00.15" />
                                <DoubleAnimation
                                    Storyboard.TargetName="SettingsTxt"
                                    Storyboard.TargetProperty="Width"
                                    From="0"
                                    To="44"
                                    Duration="00:00:00.15" />
                                <DoubleAnimation
                                    Storyboard.TargetName="SettingsTxt"
                                    Storyboard.TargetProperty="Opacity"
                                    From="0"
                                    To="1"
                                    Duration="00:00:00.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                    <EventTrigger RoutedEvent="Button.MouseLeave" SourceName="SettingsBtn">
                        <BeginStoryboard>
                            <Storyboard>
                                <DoubleAnimation
                                    Storyboard.TargetName="SettingsBtn"
                                    Storyboard.TargetProperty="Width"
                                    From="76"
                                    To="32"
                                    Duration="00:00:00.15" />
                                <DoubleAnimation
                                    Storyboard.TargetName="SettingsTxt"
                                    Storyboard.TargetProperty="Width"
                                    From="44"
                                    To="0"
                                    Duration="00:00:00.15" />
                                <DoubleAnimation
                                    Storyboard.TargetName="SettingsTxt"
                                    Storyboard.TargetProperty="Opacity"
                                    From="1"
                                    To="0"
                                    Duration="00:00:00.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </EventTrigger>
                </ui:Button.Triggers>
            </ui:Button>
        </VirtualizingStackPanel>
        <VirtualizingStackPanel
            Grid.Column="1"
            Margin="3"
            HorizontalAlignment="Right"
            Orientation="Horizontal">
            <ui:Button
                x:Name="SearchBtn"
                Width="32"
                Height="32"
                Margin="0,0,3,0"
                Padding="0"
                Background="Transparent">
                <VirtualizingStackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Kind="LayersSearch" />
                </VirtualizingStackPanel>
            </ui:Button>
            <StackPanel
                Width="32"
                Height="32"
                Margin="0,0,3,0"
                Orientation="Vertical">

                <ui:Button
                    x:Name="NotifsBtn"
                    Width="32"
                    Height="32"
                    Padding="0"
                    Background="Transparent"
                    Click="OnButtonClick">
                    <VirtualizingStackPanel Orientation="Horizontal">
                        <iconPacks:PackIconFontAwesome Kind="BellRegular" />
                    </VirtualizingStackPanel>
                </ui:Button>
                <ui:Flyout
                    x:Name="NotifsFlyout"
                    Margin="0"
                    Padding="0"
                    Background="{DynamicResource ControlBarFillColorSecondaryBrush}"
                    IsOpen="False"
                    Placement="Center"
                    VerticalOffset="240">
                    <local:NotificationFlyout x:Name="NotifsFlyoutContent" />
                </ui:Flyout>
                <ui:SymbolIcon
                    x:Name="NotifsNoticeIcon"
                    Margin="14.5,-47.5,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Filled="True"
                    FontSize="8"
                    Foreground="{DynamicResource SystemAccentColorPrimaryBrush}"
                    Symbol="Circle24" />
            </StackPanel>
            <ui:Button
                x:Name="ProfileBtn"
                Width="32"
                Height="32"
                Margin="0"
                Padding="0"
                Background="Transparent">
                <VirtualizingStackPanel Orientation="Horizontal">
                    <iconPacks:PackIconFontAwesome Kind="UserCircleRegular" />
                </VirtualizingStackPanel>
            </ui:Button>
        </VirtualizingStackPanel>
    </Grid>
</UserControl>
