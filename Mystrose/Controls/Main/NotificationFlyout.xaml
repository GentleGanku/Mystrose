<UserControl
    x:Class="Mystrose.Controls.Main.NotificationFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:local="clr-namespace:Mystrose.Controls.Main"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    mc:Ignorable="d">

    <Grid Width="300" Height="500">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Grid
            Grid.Row="0"
            Grid.Column="0"
            Margin="10,10,10,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                FontFamily="{StaticResource BDMerced}"
                FontSize="24">
                Notifications
            </TextBlock>
            <ComboBox
                x:Name="GroupBox"
                Grid.Column="1"
                MinWidth="72"
                MaxWidth="72"
                HorizontalAlignment="Right"
                Background="#3e3e48"
                ContextMenu="{x:Null}"
                SelectedIndex="0"
                TextElement.FontFamily="{StaticResource Poppins}" />
        </Grid>
        <Border
            Grid.Row="1"
            Grid.Column="0"
            Margin="10,0"
            BorderBrush="#52525e"
            BorderThickness="0.5"
            CornerRadius="0.5"
            Opacity="0.25" />

        <TextBlock
            x:Name="EmptyNotifsTxt"
            Grid.Row="2"
            Grid.Column="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontFamily="{StaticResource BDMerced}"
            FontSize="18"
            Opacity="0.5"
            Visibility="Visible">
            No new notifications
        </TextBlock>
        <ListView
            x:Name="NotifsList"
            Grid.Row="2"
            Grid.Column="0"
            Margin="10,0"
            ScrollViewer.CanContentScroll="False"
            Visibility="Collapsed" />

        <Border
            Grid.Row="3"
            Grid.Column="0"
            Margin="10,0,10,5"
            BorderBrush="#52525e"
            BorderThickness="0.5"
            CornerRadius="0.5"
            Opacity="0.25" />
        <Border
            x:Name="UnreadBorder"
            Grid.Row="4"
            Height="30"
            Margin="10,0,10,5"
            HorizontalAlignment="Stretch"
            VerticalAlignment="Center"
            Background="{DynamicResource BorderBackgroundFillColorDefaultBrush}"
            CornerRadius="5">
            <TextBlock
                x:Name="UnreadTxt"
                Padding="0,0,0,0.5"
                VerticalAlignment="Center"
                FontFamily="{StaticResource Poppins}"
                Opacity="0.75"
                TextAlignment="Center">
                0 unread message(s)
            </TextBlock>
        </Border>

        <!--<Border
            Grid.Row="2"
            Grid.Column="0"
            Margin="10,0"
            BorderBrush="#2F2F37"
            BorderThickness="0,1"
            CornerRadius="0.5"/>-->
    </Grid>

</UserControl>
