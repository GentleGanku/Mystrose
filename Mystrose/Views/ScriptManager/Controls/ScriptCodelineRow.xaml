<UserControl
    x:Class="Mystrose.Views.ScriptManager.Controls.ScriptCodelineRow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Mystrose.Views.ScriptManager.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="32"
    mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <TextBlock
            x:Name="TB_Captiond"
            Grid.Column="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontFamily="{StaticResource FF_HypatiaSans_Semibold}"
            FontSize="14">
            Commands
        </TextBlock>

        <StackPanel Grid.Column="1" Orientation="Vertical">
            <TextBlock
                x:Name="TB_Captions"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="{StaticResource FF_HypatiaSans_Semibold}"
                FontSize="14">
                Commands
            </TextBlock>
            <TextBlock
                x:Name="TB_Captiona"
                Grid.Column="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                FontFamily="{StaticResource FF_HypatiaSans_Semibold}"
                FontSize="14">
                Commands
            </TextBlock>
        </StackPanel>
    </Grid>

</UserControl>
