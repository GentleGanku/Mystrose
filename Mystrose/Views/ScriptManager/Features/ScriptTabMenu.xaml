<UserControl
    x:Class="Mystrose.Views.ScriptManager.Features.ScriptTabMenu"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:baseControls="clr-namespace:Mystrose.Views.ScriptManager.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Mystrose.Views.ScriptManager.Features"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="36"
    d:DesignWidth="600"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border
            Grid.Row="0"
            HorizontalAlignment="Stretch"
            Background="{DynamicResource ButtonBackground}"
            BorderBrush="{DynamicResource ControlElevationBorderBrush}"
            BorderThickness="1"
            CornerRadius="4">
            <ui:DynamicScrollViewer
                x:Name="DSV_Tabs"
                HorizontalAlignment="Stretch"
                ScrollViewer.CanContentScroll="False"
                ScrollViewer.PanningMode="HorizontalOnly"
                VirtualizingPanel.ScrollUnit="Pixel">
                <StackPanel
                    x:Name="SPNL_Tabs"
                    Background="{DynamicResource StripedBackgroundBrush}"
                    Orientation="Horizontal">

                    <baseControls:TabMenuButton
                        x:Name="TBTN_Commands"
                        CaptionText="Commands"
                        IsSelected="False">
                        <baseControls:TabMenuButton.IconContent>
                            <ui:SymbolIcon Symbol="Layer24" />
                        </baseControls:TabMenuButton.IconContent>
                    </baseControls:TabMenuButton>

                    <Separator Height="24" Margin="3,0" />

                    <baseControls:TabMenuButton
                        x:Name="TBTN_Triggers"
                        CaptionText="Triggers"
                        IsSelected="False">
                        <baseControls:TabMenuButton.IconContent>
                            <ui:SymbolIcon Symbol="TapSingle24" />
                        </baseControls:TabMenuButton.IconContent>
                    </baseControls:TabMenuButton>

                    <Separator Height="24" Margin="3,0" />

                    <baseControls:TabMenuButton
                        x:Name="TBTN_Variables"
                        CaptionText="Variables"
                        IsSelected="False">
                        <baseControls:TabMenuButton.IconContent>
                            <ui:SymbolIcon Symbol="BracesVariable24" />
                        </baseControls:TabMenuButton.IconContent>
                    </baseControls:TabMenuButton>

                    <Separator Height="24" Margin="3,0" />
                </StackPanel>
            </ui:DynamicScrollViewer>
        </Border>

        <ContentPresenter x:Name="CPST_Page" Grid.Row="1" />
    </Grid>

</UserControl>
