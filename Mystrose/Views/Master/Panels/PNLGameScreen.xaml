<base:MystPanel
    x:Class="Mystrose.Views.Master.Panels.PNLGameScreen"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Mystrose.Views.Base"
    xmlns:baseControls="clr-namespace:Mystrose.Views.Base.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Mystrose.Views.Master.Panels"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="550"
    d:DesignWidth="959"
    Loaded="OnLoaded"
    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
    Unloaded="OnUnloaded"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="GRD_Buffer"
            Grid.Row="0"
            Visibility="Visible">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel
                Grid.Column="0"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Orientation="Vertical">
                <TextBlock
                    FontFamily="{StaticResource FF_Albertus_Regular}"
                    FontSize="28"
                    FontWeight="Bold"
                    Text="New Game Tab"
                    TextAlignment="Center" />
                <Separator Grid.Row="1" Margin="0,5" />
                <TextBlock
                    Grid.Row="2"
                    Margin="0,5"
                    FontFamily="{StaticResource FF_HypatiaSans_Regular}"
                    FontSize="14"
                    LineHeight="20"
                    Opacity="0.75"
                    TextAlignment="Center"
                    TextWrapping="Wrap">
                    Game client is loading onto the new tab. Please wait...
                </TextBlock>
            </StackPanel>

            <Image
                Width="250"
                Height="250"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Panel.ZIndex="-1"
                Opacity="0.25"
                RenderOptions.BitmapScalingMode="HighQuality"
                SnapsToDevicePixels="True"
                Source="pack://application:,,,/Resources/Graphics/Mystrose.png"
                UseLayoutRounding="True" />
        </Grid>
        <Grid
            x:Name="GRD_GameScreen"
            Grid.Row="0"
            Visibility="Collapsed" />

    </Grid>

</base:MystPanel>
