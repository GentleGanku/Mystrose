<base:MystWindow
    Height="600"
    ResizeMode="CanResize"
    Title="World Visualizer | Mystrose"
    Width="750"
    WindowStartupLocation="CenterScreen"
    WindowState="Normal"
    mc:Ignorable="d"
    x:Class="Mystrose.Views.WorldVisualizer.VWWorldVisualizer"
    x:Name="WorldVisualizer"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:base="clr-namespace:Mystrose.Views.Base"
    xmlns:baseControls="clr-namespace:Mystrose.Views.Base.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Mystrose.Views.WorldVisualizer"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <d:DesignerProperties.DesignStyle>
        <Style TargetType="ui:FluentWindow">
            <Setter Property="Background" Value="{DynamicResource LayerFillColorAltBrush}" />
            <Setter Property="Height" Value="600" />
            <Setter Property="Width" Value="750" />
        </Style>
    </d:DesignerProperties.DesignStyle>

    <Grid Background="{DynamicResource LayerFillColorAltBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <baseControls:TitleBar
            Grid.Row="0"
            TitleIcon="SearchVisual20"
            TitleText="World Visualizer"
            x:Name="TTLB_Main">
            <baseControls:TitleBar.AdditionalContent>
                <baseControls:ClientSwitchButton Tag="CSBTN_Codenames" />
            </baseControls:TitleBar.AdditionalContent>
        </baseControls:TitleBar>
        <Rectangle
            Fill="{DynamicResource TextOnAccentFillColorPrimaryBrush}"
            Grid.Row="1"
            Height="0.5" />

        <Grid Grid.Row="2" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,7.5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,6,0"
                    Text="Grabber"
                    TextElement.FontFamily="{StaticResource FF_HypatiaSans_Semibold}"
                    TextElement.FontSize="14"
                    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    VerticalAlignment="Center" />

                <Border
                    Background="{DynamicResource SeparatorBorderBrush}"
                    CornerRadius="0.5"
                    Grid.Column="1"
                    Height="24"
                    Margin="0,0,6,0"
                    Width="1" />

                <Border
                    Background="{DynamicResource ButtonBackground}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Grid.Column="2"
                    Margin="0,0,6,0">
                    <baseControls:MenuButton CaptionText="How does it work?" x:Name="MBTN_GrabberInfo">
                        <baseControls:MenuButton.IconContent>
                            <ui:SymbolIcon Symbol="Lightbulb20" />
                        </baseControls:MenuButton.IconContent>
                    </baseControls:MenuButton>
                </Border>

                <Border
                    Background="{DynamicResource SeparatorBorderBrush}"
                    CornerRadius="0.5"
                    Grid.Column="3"
                    Height="1" />

            </Grid>
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Opacity="0.5"
                    TextAlignment="Left"
                    TextElement.FontFamily="{StaticResource FF_HypatiaSans_Regular}"
                    TextElement.FontSize="14"
                    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    TextWrapping="Wrap"
                    VerticalAlignment="Center"
                    Visibility="Collapsed"
                    x:Name="TB_Results">
                    1 result found
                </TextBlock>
                <Border
                    Background="{DynamicResource ButtonBackground}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <baseControls:MenuButton x:Name="MBTN_Refresh">
                            <baseControls:MenuButton.ToolTip>
                                Refresh the Grabber
                            </baseControls:MenuButton.ToolTip>

                            <baseControls:MenuButton.IconContent>
                                <ui:SymbolIcon Symbol="ArrowClockwise20" />
                            </baseControls:MenuButton.IconContent>
                        </baseControls:MenuButton>
                    </StackPanel>
                </Border>
                <ComboBox
                    FontFamily="{StaticResource FF_HypatiaSans_Semibold}"
                    Grid.Column="2"
                    HorizontalAlignment="Left"
                    Margin="6,0,3,0"
                    MaxWidth="150"
                    MinWidth="150"
                    SelectionChanged="ObjectTypesBox_SelectionChanged"
                    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    x:Name="CB_VisualType" />
            </Grid>
            <Border
                Background="{DynamicResource CalendarViewBorderBrush}"
                BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="8"
                Grid.Row="2"
                Margin="0,9,3,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0.40*" />
                            <ColumnDefinition Width="0.60*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            HorizontalAlignment="Center"
                            Opacity="0.5"
                            Padding="25,0"
                            TextAlignment="Center"
                            TextElement.FontFamily="{StaticResource FF_HypatiaSans_Semibold}"
                            TextElement.FontSize="14"
                            TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            TextWrapping="Wrap"
                            VerticalAlignment="Center"
                            Visibility="Visible"
                            x:Name="TB_EmptyView">
                            Select a game object type and refresh the view to see the details
                        </TextBlock>
                        <TreeView
                            AllowDrop="True"
                            Grid.Column="0"
                            HorizontalContentAlignment="Stretch"
                            Margin="6"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Visible"
                            TextElement.FontFamily="{StaticResource FF_HypatiaSans_Regular}"
                            TextElement.FontSize="12"
                            VirtualizingPanel.IsVirtualizing="True"
                            Visibility="Collapsed"
                            x:Name="TV_Models" />

                        <Border
                            Background="{DynamicResource CardStrokeColorDefaultBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            CornerRadius="0,8,0,0"
                            Grid.Column="1">
                            <ui:DynamicScrollViewer Margin="6" VirtualizingPanel.IsVirtualizing="True">
                                <StackPanel
                                    HorizontalAlignment="Stretch"
                                    Orientation="Vertical"
                                    TextElement.FontFamily="{StaticResource FF_HypatiaSans_Regular}"
                                    TextElement.FontSize="12"
                                    x:Name="SPNL_Attributes" />
                            </ui:DynamicScrollViewer>
                        </Border>
                    </Grid>

                    <Border
                        Background="{DynamicResource CalendarViewBorderBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        CornerRadius="0,0,8,8"
                        Grid.Row="1"
                        TextElement.FontFamily="{StaticResource FF_HypatiaSans_Regular}"
                        TextElement.FontSize="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="0.40*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="0.60*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <ui:TextBox
                                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                    Grid.Column="0"
                                    Margin="9,9,9,9"
                                    MinWidth="175"
                                    PlaceholderText="Search keyword..."
                                    TextChanged="SearchBox_TextChanged"
                                    x:Name="TBX_Search" />
                            </Grid>

                            <Separator Grid.Column="1" Height="50" />

                            <Grid Grid.Column="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border
                                    Background="{DynamicResource ButtonBackground}"
                                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    HorizontalAlignment="Left"
                                    Margin="9,8,9,9"
                                    Visibility="Collapsed"
                                    x:Name="BRD_ActionButtons">
                                    <StackPanel Orientation="Horizontal" x:Name="SP_ActionButtons">
                                        <baseControls:MenuButton
                                            Margin="0,0,0,0"
                                            ToolTip="Search on wiki"
                                            x:Name="MBTN_WikiSearch">
                                            <baseControls:MenuButton.IconContent>
                                                <ui:SymbolIcon Symbol="GlobeSearch20" />
                                            </baseControls:MenuButton.IconContent>
                                        </baseControls:MenuButton>

                                        <baseControls:MenuButton
                                            Margin="0,0,0,0"
                                            ToolTip="Go to wiki page"
                                            x:Name="MBTN_WikiPage">
                                            <baseControls:MenuButton.IconContent>
                                                <ui:SymbolIcon Symbol="BookSearch20" />
                                            </baseControls:MenuButton.IconContent>
                                        </baseControls:MenuButton>

                                        <baseControls:MenuButton
                                            Margin="0,0,0,0"
                                            ToolTip="Wear item (client-side)"
                                            x:Name="MBTN_WearItem">
                                            <baseControls:MenuButton.IconContent>
                                                <ui:SymbolIcon Symbol="BoxCheckmark20" />
                                            </baseControls:MenuButton.IconContent>
                                        </baseControls:MenuButton>

                                        <baseControls:MenuButton
                                            Margin="0,0,0,0"
                                            ToolTip="Load quest"
                                            x:Name="MBTN_LoadQuest">
                                            <baseControls:MenuButton.IconContent>
                                                <ui:SymbolIcon Symbol="CommentArrowLeft24" />
                                            </baseControls:MenuButton.IconContent>
                                        </baseControls:MenuButton>

                                        <baseControls:MenuButton
                                            Margin="0,0,0,0"
                                            ToolTip="Accept quest"
                                            x:Name="MBTN_AcceptQuest">
                                            <baseControls:MenuButton.IconContent>
                                                <ui:SymbolIcon Symbol="CommentAdd20" />
                                            </baseControls:MenuButton.IconContent>
                                        </baseControls:MenuButton>

                                        <baseControls:MenuButton
                                            Margin="0,0,0,0"
                                            ToolTip="Abandon quest"
                                            x:Name="MBTN_AbandonQuest">
                                            <baseControls:MenuButton.IconContent>
                                                <ui:SymbolIcon Symbol="CommentDismiss20" />
                                            </baseControls:MenuButton.IconContent>
                                        </baseControls:MenuButton>

                                        <baseControls:MenuButton
                                            Margin="0,0,0,0"
                                            ToolTip="Complete quest"
                                            x:Name="MBTN_CompleteQuest">
                                            <baseControls:MenuButton.IconContent>
                                                <ui:SymbolIcon Symbol="CommentCheckmark20" />
                                            </baseControls:MenuButton.IconContent>
                                        </baseControls:MenuButton>

                                        <baseControls:MenuButton
                                            Margin="0,0,0,0"
                                            ToolTip="Accept item drop"
                                            x:Name="MBTN_AcceptDrop">
                                            <baseControls:MenuButton.IconContent>
                                                <ui:SymbolIcon Symbol="HandRight20" />
                                            </baseControls:MenuButton.IconContent>
                                        </baseControls:MenuButton>

                                        <baseControls:MenuButton
                                            Margin="0,0,0,0"
                                            ToolTip="Reject item drop"
                                            x:Name="MBTN_RejectDrop">
                                            <baseControls:MenuButton.IconContent>
                                                <ui:SymbolIcon Symbol="HandRightOff20" />
                                            </baseControls:MenuButton.IconContent>
                                        </baseControls:MenuButton>
                                    </StackPanel>
                                </Border>
                            </Grid>

                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="15,0,15,15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,7.5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock
                    Grid.Column="0"
                    Margin="0,0,6,0"
                    Text="Loader"
                    TextElement.FontFamily="{StaticResource FF_HypatiaSans_Semibold}"
                    TextElement.FontSize="14"
                    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                    VerticalAlignment="Center" />

                <Border
                    Background="{DynamicResource SeparatorBorderBrush}"
                    CornerRadius="0.5"
                    Grid.Column="1"
                    Height="24"
                    Margin="0,0,6,0"
                    Width="1" />

                <Border
                    Background="{DynamicResource ButtonBackground}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Grid.Column="2"
                    Margin="0,0,6,0">
                    <baseControls:MenuButton CaptionText="How does it work?" x:Name="MBTN_LoaderInfo">
                        <baseControls:MenuButton.IconContent>
                            <ui:SymbolIcon Symbol="Lightbulb20" />
                        </baseControls:MenuButton.IconContent>
                    </baseControls:MenuButton>
                </Border>

                <Border
                    Background="{DynamicResource SeparatorBorderBrush}"
                    CornerRadius="0.5"
                    Grid.Column="3"
                    Height="1" />

            </Grid>
            <Grid Grid.Row="2" Margin="0,7.5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel
                    Grid.Column="0"
                    Margin="0,0,12,0"
                    Orientation="Vertical">
                    <TextBlock
                        Margin="0,0,0,3"
                        Opacity="0.5"
                        Text="Game Object"
                        TextElement.FontFamily="{StaticResource FF_HypatiaSans_Regular}"
                        TextElement.FontSize="12"
                        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <ComboBox
                        FontFamily="{StaticResource FF_HypatiaSans_Semibold}"
                        MaxWidth="200"
                        MinWidth="200"
                        SelectionChanged="ObjectTypesBox_SelectionChanged"
                        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                        x:Name="CB_ModelType" />
                </StackPanel>

                <StackPanel
                    Grid.Column="1"
                    Margin="12,0,0,0"
                    Orientation="Vertical">
                    <TextBlock
                        Margin="0,0,0,3"
                        Opacity="0.5"
                        Text="Parameters"
                        TextElement.FontFamily="{StaticResource FF_HypatiaSans_Regular}"
                        TextElement.FontSize="12"
                        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <ui:TextBox
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        HorizontalAlignment="Stretch"
                        x:Name="TBX_Parameters" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Margin="6,0,0,0"
                    Orientation="Vertical">
                    <TextBlock
                        Margin="0,0,0,3"
                        Opacity="0.5"
                        Text=""
                        TextElement.FontFamily="{StaticResource FF_HypatiaSans_Regular}"
                        TextElement.FontSize="12"
                        TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />
                    <Border
                        Background="{DynamicResource ButtonBackground}"
                        BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="4">
                        <baseControls:MenuButton Height="33.5" x:Name="MBTN_Load">
                            <baseControls:MenuButton.ToolTip>
                                Load the Game Object
                            </baseControls:MenuButton.ToolTip>

                            <baseControls:MenuButton.IconContent>
                                <ui:SymbolIcon Symbol="ArrowUpRight20" />
                            </baseControls:MenuButton.IconContent>
                        </baseControls:MenuButton>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>

        <!--  MystWindow's Base Controls  -->
        <ContentPresenter
            Grid.Row="1"
            Grid.RowSpan="4"
            x:Name="CPST_ContentDialog" />
        <ui:SnackbarPresenter
            Grid.Row="1"
            Grid.RowSpan="4"
            x:Name="SBPST_Base" />

    </Grid>

    <base:MystWindow.Resources>
        <ResourceDictionary>
            <Style TargetType="{x:Type TreeViewItem}">
                <!--  Universal WPF UI focus  -->
                <Setter Property="FocusVisualStyle" Value="{DynamicResource DefaultControlFocusVisualStyle}" />
                <!--  Universal WPF UI focus  -->
                <Setter Property="Foreground" Value="{DynamicResource TreeViewItemForeground}" />
                <Setter Property="Background" Value="{DynamicResource TreeViewItemBackground}" />
                <Setter Property="Padding" Value="4" />
                <Setter Property="FontSize" Value="{StaticResource TreeViewItemFontSize}" />
                <Setter Property="Border.CornerRadius" Value="{DynamicResource ControlCornerRadius}" />
                <Setter Property="IsTabStop" Value="True" />
                <Setter Property="OverridesDefaultStyle" Value="True" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type TreeViewItem}">
                            <Grid Background="{TemplateBinding Background}">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border
                                    CornerRadius="{TemplateBinding Border.CornerRadius}"
                                    Grid.Row="0"
                                    x:Name="Border">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition MinWidth="19" Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle
                                            Fill="{DynamicResource TreeViewItemSelectionIndicatorForeground}"
                                            Grid.Column="0"
                                            Height="16"
                                            HorizontalAlignment="Left"
                                            Margin="0,0,0,0"
                                            RadiusX="2"
                                            RadiusY="2"
                                            VerticalAlignment="Center"
                                            Visibility="Collapsed"
                                            Width="3"
                                            x:Name="ActiveRectangle" />
                                        <ToggleButton
                                            ClickMode="Press"
                                            Grid.Column="0"
                                            IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}"
                                            Margin="8,0,4,0"
                                            Style="{StaticResource ExpandCollapseToggleButtonStyle}"
                                            x:Name="Expander" />
                                        <ContentPresenter
                                            ContentSource="Header"
                                            Grid.Column="1"
                                            HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                            Margin="{TemplateBinding Padding}"
                                            TextElement.FontSize="{TemplateBinding FontSize}"
                                            x:Name="PART_Header" />
                                    </Grid>
                                </Border>
                                <Grid Grid.Row="1">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition MinWidth="19" Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ItemsPresenter
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        Visibility="Collapsed"
                                        x:Name="ItemsHost" />
                                </Grid>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="HasItems" Value="False">
                                    <Setter Property="Visibility" TargetName="Expander" Value="Collapsed" />
                                </Trigger>
                                <Trigger Property="IsExpanded" Value="True">
                                    <Setter Property="Visibility" TargetName="ItemsHost" Value="Visible" />
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" TargetName="Border" Value="{DynamicResource TreeViewItemBackgroundPointerOver}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter Property="Background" TargetName="Border" Value="{DynamicResource TreeViewItemBackgroundSelected}" />
                                    <Setter Property="Visibility" TargetName="ActiveRectangle" Value="Visible" />
                                </Trigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="HasHeader" Value="False" />
                                        <Condition Property="Width" Value="Auto" />
                                    </MultiTrigger.Conditions>
                                    <Setter Property="MinWidth" TargetName="PART_Header" Value="75" />
                                </MultiTrigger>
                                <MultiTrigger>
                                    <MultiTrigger.Conditions>
                                        <Condition Property="HasHeader" Value="False" />
                                        <Condition Property="Height" Value="Auto" />
                                    </MultiTrigger.Conditions>
                                    <Setter Property="MinHeight" TargetName="PART_Header" Value="19" />
                                </MultiTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="VirtualizingPanel.IsVirtualizing" Value="True">
                        <Setter Property="ItemsPanel">
                            <Setter.Value>
                                <ItemsPanelTemplate>
                                    <VirtualizingStackPanel />
                                </ItemsPanelTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>
        </ResourceDictionary>
    </base:MystWindow.Resources>

</base:MystWindow>
