<UserControl
    Loaded="OnLoaded"
    Unloaded="OnUnloaded"
    d:DesignWidth="959"
    mc:Ignorable="d"
    x:Class="Mystrose.Views.WorldVisualizer.Controls.VisualizerItem"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:baseControls="clr-namespace:Mystrose.Views.Base.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Mystrose.Views.WorldVisualizer.Controls"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock
            FontFamily="{StaticResource FF_HypatiaSans_Regular}"
            FontSize="14"
            Grid.Row="0"
            Text="Hello, World!"
            x:Name="TB_Label">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding Path=Tag, ElementName=TB_Label}" Value="Auras">
                            <Setter Property="Foreground" Value="{StaticResource FG_Model_Auras}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=Tag, ElementName=TB_Label}" Value="Cells">
                            <Setter Property="Foreground" Value="{StaticResource FG_Model_Cells}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=Tag, ElementName=TB_Label}" Value="Combat Messages">
                            <Setter Property="Foreground" Value="{StaticResource FG_Model_CombatMessages}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=Tag, ElementName=TB_Label}" Value="Event Messages">
                            <Setter Property="Foreground" Value="{StaticResource FG_Model_EventMessages}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=Tag, ElementName=TB_Label}" Value="Factions">
                            <Setter Property="Foreground" Value="{StaticResource FG_Model_Factions}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=Tag, ElementName=TB_Label}" Value="Inventory Items">
                            <Setter Property="Foreground" Value="{StaticResource FG_Model_InventoryItems}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=Tag, ElementName=TB_Label}" Value="Item Drops">
                            <Setter Property="Foreground" Value="{StaticResource FG_Model_ItemDrops}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=Tag, ElementName=TB_Label}" Value="Monsters">
                            <Setter Property="Foreground" Value="{StaticResource FG_Model_Monsters}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=Tag, ElementName=TB_Label}" Value="Players">
                            <Setter Property="Foreground" Value="{StaticResource FG_Model_Players}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=Tag, ElementName=TB_Label}" Value="Quests">
                            <Setter Property="Foreground" Value="{StaticResource FG_Model_Quests}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=Tag, ElementName=TB_Label}" Value="Shop Items">
                            <Setter Property="Foreground" Value="{StaticResource FG_Model_ShopItems}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Path=Tag, ElementName=TB_Label}" Value="Skills">
                            <Setter Property="Foreground" Value="{StaticResource FG_Model_Skills}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
        <TextBlock
            FontFamily="{StaticResource FF_HypatiaSans_Regular}"
            FontSize="10"
            Grid.Row="1"
            Opacity="0.5"
            Text="Hello, World!"
            x:Name="TB_Context" />
    </Grid>

</UserControl>