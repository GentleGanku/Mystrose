<UserControl
    x:Class="Mystrose.Views.Panels.MainWindow.HomePanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    d:DesignHeight="540"
    d:DesignWidth="959"
    Background="{DynamicResource ApplicationBackgroundBrush}"
    mc:Ignorable="d">

    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <Grid
            Grid.Column="0"
            Width="450"
            Margin="0,0,25,0"
            HorizontalAlignment="Left"
            VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel
                Grid.Row="0"
                Margin="5,0"
                Orientation="Horizontal">
                <TextBlock
                    Margin="5,5,15,5"
                    Padding="0,0,0,9.5"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource BDMerced}"
                    FontSize="32">
                    Mystrose
                </TextBlock>
                <Border
                    Width="60"
                    Height="30"
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource BorderBackgroundFillColorDefaultBrush}"
                    CornerRadius="5">
                    <TextBlock
                        Margin="5"
                        Padding="0,0,0,0.5"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource BDMerced}"
                        FontSize="14"
                        Opacity="0.6"
                        TextAlignment="Center">
                        v0.1.0
                    </TextBlock>
                </Border>
                <Border
                    Width="60"
                    Height="30"
                    Margin="5"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="{DynamicResource BorderBackgroundFillColorDefaultBrush}"
                    CornerRadius="5">
                    <TextBlock
                        Margin="5"
                        Padding="0,0,0,0.5"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource BDMerced}"
                        FontSize="14"
                        Opacity="0.6"
                        TextAlignment="Center">
                        Alpha
                    </TextBlock>
                </Border>
            </StackPanel>
            <TextBlock
                Grid.Row="1"
                Margin="10,5"
                FontFamily="{StaticResource Poppins}"
                FontSize="14"
                TextWrapping="Wrap">
                The modern and customizable botting client for the MMORPG game, AdventureQuest Worlds.
            </TextBlock>
            <Border
                Grid.Row="2"
                Width="450"
                Height="0.5"
                Margin="0,7.5"
                HorizontalAlignment="Center"
                Background="{DynamicResource SeparatorStrokeColorDefaultBrush}"
                CornerRadius="0.25"
                Opacity="0.5" />
            <StackPanel
                Grid.Row="3"
                Margin="5,2.5,5,5"
                Orientation="Vertical">
                <CheckBox
                    x:Name="SkipHomeBtn"
                    Margin="5,0"
                    FontFamily="{StaticResource Poppins}"
                    FontSize="11">
                    Skip the Homepage on launch
                </CheckBox>
            </StackPanel>
            <Grid Grid.Row="4" Margin="10,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <ui:Button
                    x:Name="PlayBtn"
                    Grid.Column="0"
                    Height="32"
                    Margin="0,0,5,0"
                    Padding="0"
                    HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Width="16"
                            Height="16"
                            Symbol="Add20" />
                        <TextBlock
                            Name="PlayTxt"
                            Height="16"
                            Padding="5,0"
                            HorizontalAlignment="Left"
                            FontFamily="{StaticResource Poppins}"
                            FontSize="11">
                            New Tab
                        </TextBlock>
                    </StackPanel>
                </ui:Button>
                <ui:Button
                    x:Name="DiscordBtn"
                    Grid.Column="1"
                    Height="32"
                    Margin="0,0,5,0"
                    Padding="0"
                    HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon
                            Width="16"
                            Height="16"
                            Symbol="AppTitle20" />
                        <TextBlock
                            Name="DiscordTxt"
                            Height="16"
                            Padding="5,0"
                            HorizontalAlignment="Left"
                            FontFamily="{StaticResource Poppins}"
                            FontSize="11">
                            Discord
                        </TextBlock>
                    </StackPanel>
                </ui:Button>
                <ui:Button
                    x:Name="WebsiteBtn"
                    Grid.Column="2"
                    Height="32"
                    Margin="0,0,5,0"
                    Padding="0"
                    HorizontalAlignment="Stretch">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="WebAsset20" />
                        <TextBlock
                            Name="WebsiteTxt"
                            Height="16"
                            Padding="5,0"
                            HorizontalAlignment="Left"
                            FontFamily="{StaticResource Poppins}"
                            FontSize="11">
                            Website
                        </TextBlock>
                    </StackPanel>
                </ui:Button>
                <ui:Button
                    x:Name="PatreonBtn"
                    Grid.Column="3"
                    Height="32"
                    Margin="0"
                    Padding="0"
                    HorizontalAlignment="Stretch"
                    IsEnabled="False">
                    <StackPanel Orientation="Horizontal">
                        <ui:SymbolIcon Symbol="Money16" />
                        <TextBlock
                            Name="PatreonTxt"
                            Height="16"
                            Padding="5,0"
                            HorizontalAlignment="Left"
                            FontFamily="{StaticResource Poppins}"
                            FontSize="11">
                            Patreon
                        </TextBlock>
                    </StackPanel>
                </ui:Button>
            </Grid>
        </Grid>
        <StackPanel
            Grid.Column="1"
            HorizontalAlignment="Right"
            VerticalAlignment="Center">
            <Image
                Width="275"
                Height="275"
                Opacity="1"
                RenderOptions.BitmapScalingMode="HighQuality"
                SnapsToDevicePixels="True"
                Source="pack://application:,,,/Resources/Images/Mystrose.png"
                UseLayoutRounding="True" />
        </StackPanel>
    </Grid>

</UserControl>
