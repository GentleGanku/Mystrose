<base:MystWindow
    x:Class="Mystrose.Views.Interceptor.VWPacketInterceptor"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Mystrose.Views.Base"
    xmlns:baseControls="clr-namespace:Mystrose.Views.Base.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Mystrose.Views.Interceptor"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="Interceptor"
    Title="Packet Interceptor | Mystrose"
    Width="750"
    Height="600"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    WindowState="Normal"
    mc:Ignorable="d">

    <d:DesignerProperties.DesignStyle>
        <Style TargetType="ui:FluentWindow">
            <Setter Property="Background" Value="{DynamicResource LayerFillColorAltBrush}" />
            <Setter Property="Height" Value="600" />
            <Setter Property="Width" Value="750" />
        </Style>
    </d:DesignerProperties.DesignStyle>

    <Grid Background="{DynamicResource LayerFillColorAltBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <baseControls:TitleBar
            x:Name="TTLB_Main"
            Grid.Row="0"
            TitleIcon="VirtualNetwork20"
            TitleText="Packet Interceptor">
            <baseControls:TitleBar.AdditionalContent>
                <baseControls:ClientSwitchButton Tag="CSBTN_Codenames" />
            </baseControls:TitleBar.AdditionalContent>
        </baseControls:TitleBar>
        <Rectangle
            Grid.Row="1"
            Height="0.5"
            Fill="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />

        <Grid Grid.Row="2" Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,7.5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Background="{DynamicResource ButtonBackground}"
                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="4">
                    <StackPanel Grid.Column="0" Orientation="Horizontal">
                        <baseControls:MenuButton
                            x:Name="MBTN_CopySelected"
                            Margin="0,0,3,0"
                            CaptionText="Copy selected as text">
                            <baseControls:MenuButton.IconContent>
                                <ui:SymbolIcon Symbol="CopySelect20" />
                            </baseControls:MenuButton.IconContent>
                        </baseControls:MenuButton>

                        <baseControls:MenuButton
                            x:Name="MBTN_CopyFormatted"
                            Margin="0,0,3,0"
                            CaptionText="Copy formatted as text">
                            <baseControls:MenuButton.IconContent>
                                <ui:SymbolIcon Symbol="TableCopy20" />
                            </baseControls:MenuButton.IconContent>
                        </baseControls:MenuButton>

                        <baseControls:MenuButton
                            x:Name="MBTN_ClearCaptured"
                            Margin="0,0,0,0"
                            CaptionText="Clear all intercepted packets">
                            <baseControls:MenuButton.IconContent>
                                <ui:SymbolIcon Symbol="Broom20" />
                            </baseControls:MenuButton.IconContent>
                        </baseControls:MenuButton>

                    </StackPanel>
                </Border>

                <ui:ToggleSwitch
                    x:Name="TSBTN_Intercept"
                    Grid.Column="2"
                    Checked="InterceptToggle_CheckChanged"
                    FlowDirection="RightToLeft"
                    TextElement.FontFamily="{StaticResource FF_HypatiaSans_Semibold}"
                    TextElement.FontSize="14"
                    Unchecked="InterceptToggle_CheckChanged">
                    Intercept Packets
                </ui:ToggleSwitch>
            </Grid>

            <Grid Grid.Row="1" Margin="0,7.5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="0.75*" />
                    <ColumnDefinition Width="0.25*" />
                </Grid.ColumnDefinitions>

                <Border
                    Grid.Column="0"
                    Margin="0,0,3,0"
                    Background="{DynamicResource CalendarViewBorderBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ui:ListView
                            x:Name="LV_Packets"
                            Grid.Row="0"
                            Margin="6"
                            HorizontalContentAlignment="Stretch"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Visible"
                            SelectionChanged="Packets_SelectionChanged"
                            TextElement.FontFamily="{StaticResource FF_HypatiaSans_Regular}"
                            TextElement.FontSize="12"
                            VirtualizingPanel.IsVirtualizing="True">
                            <ui:ListView.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Path=.}" TextTrimming="CharacterEllipsis">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Path=Type}" Value="0">
                                                        <Setter Property="Foreground" Value="{StaticResource FG_Message_Json}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=Type}" Value="1">
                                                        <Setter Property="Foreground" Value="{StaticResource FG_Message_Xml}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=Type}" Value="2">
                                                        <Setter Property="Foreground" Value="{StaticResource FG_Message_Xt}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding Path=Type}" Value="3">
                                                        <Setter Property="Foreground" Value="{StaticResource FG_Message_Zm}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </DataTemplate>
                            </ui:ListView.ItemTemplate>
                        </ui:ListView>

                        <Border
                            Grid.Row="1"
                            Background="{DynamicResource CalendarViewBorderBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            CornerRadius="0,0,8,8"
                            TextElement.FontFamily="{StaticResource FF_HypatiaSans_Regular}"
                            TextElement.FontSize="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ComboBox
                                    x:Name="CB_PacketTypes"
                                    Grid.Column="0"
                                    MinWidth="85"
                                    MaxWidth="85"
                                    Margin="12,9,3,9"
                                    HorizontalAlignment="Left"
                                    FontFamily="{StaticResource FF_HypatiaSans_Semibold}"
                                    SelectionChanged="PacketTypes_SelectionChanged"
                                    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

                                <ui:TextBox
                                    x:Name="TBX_FilterCommand"
                                    Grid.Column="1"
                                    Width="150"
                                    Margin="3,9,0,9"
                                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                    PlaceholderText="Filter command..."
                                    TextChanged="TBX_FilterCommand_TextChanged" />

                                <StackPanel
                                    Grid.Column="3"
                                    Margin="12,9"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Vertical"
                                    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                    <TextBlock x:Name="TB_Legend1">
                                        <Border
                                            Width="10"
                                            Height="10"
                                            Margin="0,0,5,0"
                                            Background="{StaticResource FG_Message_Json}"
                                            CornerRadius="2" />
                                        JSON
                                    </TextBlock>
                                    <TextBlock x:Name="TB_Legend2">
                                        <Border
                                            Width="10"
                                            Height="10"
                                            Margin="0,0,5,0"
                                            Background="{StaticResource FG_Message_Xml}"
                                            CornerRadius="2" />
                                        XML
                                    </TextBlock>
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="4"
                                    Margin="12,9"
                                    VerticalAlignment="Center"
                                    Orientation="Vertical"
                                    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                                    <TextBlock x:Name="TB_Legend3">
                                        <Border
                                            Width="10"
                                            Height="10"
                                            Margin="0,0,5,0"
                                            Background="{StaticResource FG_Message_Xt}"
                                            CornerRadius="2" />
                                        XT
                                    </TextBlock>
                                    <TextBlock x:Name="TB_Legend4">
                                        <Border
                                            Width="10"
                                            Height="10"
                                            Margin="0,0,5,0"
                                            Background="{StaticResource FG_Message_Zm}"
                                            CornerRadius="2" />
                                        ZM
                                    </TextBlock>
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <Border
                    Grid.Column="1"
                    Margin="3,0,0,0"
                    Background="{DynamicResource CalendarViewBorderBrush}"
                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                    BorderThickness="1"
                    CornerRadius="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ui:TextBox
                            x:Name="TBX_FormattedPacket"
                            Grid.Row="0"
                            Margin="6"
                            AutoWordSelection="True"
                            ClearButtonEnabled="False"
                            IsReadOnly="True"
                            TextElement.FontFamily="{StaticResource FF_HypatiaSans_Regular}"
                            TextElement.FontSize="12"
                            TextWrapping="Wrap"
                            VirtualizingPanel.IsVirtualizing="True" />

                        <Border
                            Grid.Row="1"
                            Background="{DynamicResource CalendarViewBorderBrush}"
                            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                            CornerRadius="0,0,8,8"
                            TextElement.FontFamily="{StaticResource FF_HypatiaSans_Regular}"
                            TextElement.FontSize="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ui:TextBox
                                    x:Name="TBX_FindKeyword"
                                    Grid.Column="0"
                                    Margin="12,9,3,9"
                                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                    PlaceholderText="Find keyword..." />

                                <Border
                                    Grid.Column="1"
                                    Margin="3,9,12,9"
                                    HorizontalAlignment="Right"
                                    Background="{DynamicResource ButtonBackground}"
                                    BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                    <baseControls:MenuButton
                                        x:Name="MBTN_FindKeyword"
                                        Grid.Column="1"
                                        Margin="0,0,0,0">
                                        <baseControls:MenuButton.ToolTip>
                                            Find keyword in the packet
                                        </baseControls:MenuButton.ToolTip>

                                        <baseControls:MenuButton.IconContent>
                                            <ui:SymbolIcon Symbol="Search20" />
                                        </baseControls:MenuButton.IconContent>
                                    </baseControls:MenuButton>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

            </Grid>

        </Grid>

        <Grid Grid.Row="3" Margin="15,7.5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock
                Grid.Column="0"
                Margin="0,0,6,0"
                Text="Ongoing Packet"
                TextElement.FontFamily="{StaticResource FF_HypatiaSans_Semibold}"
                TextElement.FontSize="14"
                TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}" />

            <Border
                Grid.Column="1"
                Height="1"
                Background="{DynamicResource SeparatorBorderBrush}"
                CornerRadius="0.5" />

        </Grid>

        <Grid Grid.Row="4" Margin="15,7.5,15,15">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ui:TextBox
                x:Name="TBX_PacketSender"
                Grid.Column="0"
                Margin="0,0,7.5,0"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                ScrollViewer.VerticalScrollBarVisibility="Visible"
                TextChanged="TBX_PacketSender_TextChanged"
                TextElement.FontFamily="{StaticResource FF_HypatiaSans_Regular}"
                TextElement.FontSize="12"
                TextWrapping="Wrap" />

            <Border
                Grid.Column="1"
                HorizontalAlignment="Right"
                Background="{DynamicResource ButtonBackground}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel Grid.Column="0" Orientation="Vertical">
                    <baseControls:MenuButton x:Name="MBTN_SendToClient" Margin="0,0,0,3">
                        <baseControls:MenuButton.ToolTip>
                            Send Packet to Client
                        </baseControls:MenuButton.ToolTip>

                        <baseControls:MenuButton.IconContent>
                            <ui:SymbolIcon Symbol="ProjectionScreen20" />
                        </baseControls:MenuButton.IconContent>
                    </baseControls:MenuButton>

                    <baseControls:MenuButton x:Name="MBTN_SendToServer" Margin="0,0,0,3">
                        <baseControls:MenuButton.ToolTip>
                            Send Packet to Server
                        </baseControls:MenuButton.ToolTip>

                        <baseControls:MenuButton.IconContent>
                            <ui:SymbolIcon Symbol="Server20" />
                        </baseControls:MenuButton.IconContent>
                    </baseControls:MenuButton>

                    <baseControls:MenuButton x:Name="MBTN_ClearOngoing" Margin="0,0,0,0">
                        <baseControls:MenuButton.ToolTip>
                            Clear the Ongoing Packet
                        </baseControls:MenuButton.ToolTip>

                        <baseControls:MenuButton.IconContent>
                            <ui:SymbolIcon Symbol="Broom20" />
                        </baseControls:MenuButton.IconContent>
                    </baseControls:MenuButton>

                </StackPanel>
            </Border>

        </Grid>

        <!--  MystWindow's Base Controls  -->
        <ContentPresenter
            x:Name="CPST_ContentDialog"
            Grid.Row="1"
            Grid.RowSpan="4" />
        <ui:SnackbarPresenter
            x:Name="SBPST_Base"
            Grid.Row="1"
            Grid.RowSpan="4" />

    </Grid>

</base:MystWindow>
