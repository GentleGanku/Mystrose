<UserControl
    x:Class="Mystrose.Views.Controls.Main.GameTabBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    MinWidth="160"
    MinHeight="40"
    d:DesignHeight="40"
    d:DesignWidth="959"
    mc:Ignorable="d">

    <ui:TitleBar
        Name="TitleBar"
        Height="40"
        VerticalAlignment="Top"
        Background="{DynamicResource ControlBarFillColorDefaultBrush}"
        ShowClose="False"
        ShowMaximize="False"
        ShowMinimize="False">

        <ui:TitleBar.ContextMenu>
            <ContextMenu
                Width="225"
                IsOpen="False"
                Placement="MousePoint">
                <ui:MenuItem
                    Name="NewTabMenu"
                    Click="OnMenuItemClick"
                    FontSize="11"
                    Header="Add new tab" />
                <ui:MenuItem
                    Name="AllTabsMenu"
                    Click="OnMenuItemClick"
                    FontSize="11"
                    Header="Add full new tabs" />
            </ContextMenu>
        </ui:TitleBar.ContextMenu>

        <ui:TitleBar.Header>
            <Grid Margin="3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <ui:TabItem
                    Name="HomeBtn"
                    Grid.Column="0"
                    Width="32"
                    Height="32"
                    Padding="0"
                    ContentMode="MinimalIcon"
                    ToolTipService.InitialShowDelay="100"
                    ToolTipService.Placement="MousePoint">
                    <ui:TabItem.ToolTip>
                        <ToolTip Content="Home" />
                    </ui:TabItem.ToolTip>
                    <ui:TabItem.IconControlContent>
                        <iconPacks:PackIconTypicons Kind="Home" />
                    </ui:TabItem.IconControlContent>
                </ui:TabItem>
                <Border
                    Grid.Column="1"
                    Width="0.5"
                    Height="34"
                    Margin="3,0"
                    Background="{DynamicResource SeparatorStrokeColorDefaultBrush}"
                    CornerRadius="0.25" />
                <StackPanel Grid.Column="2" Orientation="Vertical">
                    <Grid Name="GameTabs" />
                    <Grid Name="TabGroups" Margin="0,2" />
                </StackPanel>
                <Border
                    Grid.Column="3"
                    Width="0.5"
                    Height="34"
                    Margin="3,0"
                    Background="{DynamicResource SeparatorStrokeColorDefaultBrush}"
                    CornerRadius="0.25" />
                <ui:Button
                    Name="AddTabBtn"
                    Grid.Column="4"
                    Width="32"
                    Height="32"
                    Margin="0,0,3,0"
                    Padding="0"
                    Background="Transparent"
                    ToolTipService.InitialShowDelay="100"
                    ToolTipService.Placement="MousePoint">
                    <ui:Button.ToolTip>
                        <ToolTip Content="New Tab" />
                    </ui:Button.ToolTip>
                    <ui:Button.Content>
                        <iconPacks:PackIconUnicons Kind="Plus" />
                    </ui:Button.Content>
                    <!--<ui:MenuButton.Menu>
                        <ContextMenu
                            Width="225"
                            Background="{DynamicResource MenuBackgroundBrush}"
                            BorderBrush="{DynamicResource MenuBorderBrush}"
                            TextElement.Foreground="{DynamicResource TextFillPrimaryBrush}">
                            <ui:MenuItem
                                Name="NewTabMenu"
                                Click="OnMenuItemClick"
                                FontSize="11"
                                Header="Add new tab" />
                            <ui:MenuItem
                                Name="AllTabsMenu"
                                Click="OnMenuItemClick"
                                FontSize="11"
                                Header="Add full new tabs" />
                        </ContextMenu>
                    </ui:MenuButton.Menu>-->
                </ui:Button>
                <ui:MenuButton
                    x:Name="MenuBtn"
                    Grid.Column="5"
                    Width="32"
                    Height="32"
                    Padding="0"
                    ToolTipService.InitialShowDelay="100"
                    ToolTipService.Placement="MousePoint">
                    <ui:MenuButton.ToolTip>
                        <ToolTip Content="App Menu" />
                    </ui:MenuButton.ToolTip>
                    <iconPacks:PackIconEvaIcons Kind="MenuOutline" />
                    <ui:MenuButton.Menu>
                        <ContextMenu Width="225">
                            <!--<ui:MenuItem
                                Name="ModeMenu"
                                Click="OnMenuItemClick"
                                FontSize="11"
                                Header="Multi-Game Mode" />
                            <Separator />-->
                            <ui:MenuItem
                                Name="MinimizeMenu"
                                Click="OnMenuItemClick"
                                FontSize="11"
                                Header="Minimize"
                                InputGestureText="Ctrl + Shift + Z" />
                            <ui:MenuItem
                                Name="MaximizeRestoreMenu"
                                Click="OnMenuItemClick"
                                FontSize="11"
                                Header="Maximize/Restore"
                                InputGestureText="Ctrl + Shift + X" />
                            <ui:MenuItem
                                Name="CloseMenu"
                                Click="OnMenuItemClick"
                                FontSize="11"
                                Header="Close"
                                InputGestureText="Ctrl + Shift + C" />
                        </ContextMenu>
                    </ui:MenuButton.Menu>
                </ui:MenuButton>
            </Grid>
        </ui:TitleBar.Header>
    </ui:TitleBar>

</UserControl>
