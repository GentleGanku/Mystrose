<base:MystWindow
    x:Class="Mystrose.Views.Logger.VWLogger"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:base="clr-namespace:Mystrose.Views.Base"
    xmlns:baseControls="clr-namespace:Mystrose.Views.Base.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Mystrose.Views.Logger"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    x:Name="Logger"
    Title="Logger | Mystrose"
    Width="600"
    Height="400"
    Background="{DynamicResource LayerFillColorAltBrush}"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    WindowState="Normal"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <baseControls:TitleBar
            Grid.Row="0"
            TitleIcon="Notepad20"
            TitleText="Logger" />
        <Rectangle
            Grid.Row="1"
            Height="0.5"
            Fill="{DynamicResource TextOnAccentFillColorPrimaryBrush}" />

        <Grid Grid.Row="2" Margin="15,15,15,7.5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Background="{DynamicResource ButtonBackground}"
                BorderBrush="{DynamicResource ControlElevationBorderBrush}"
                BorderThickness="1"
                CornerRadius="4">
                <StackPanel Orientation="Horizontal">
                    <baseControls:MenuButton
                        x:Name="MBTN_Scroll"
                        Margin="0,0,3,0"
                        CaptionText="Scroll to Selected Log">
                        <baseControls:MenuButton.IconContent>
                            <ui:SymbolIcon Symbol="ArrowMove20" />
                        </baseControls:MenuButton.IconContent>
                    </baseControls:MenuButton>

                    <baseControls:MenuButton
                        x:Name="MBTN_CopySelected"
                        Margin="0,0,3,0"
                        CaptionText="Copy Selected Log as Text">
                        <baseControls:MenuButton.IconContent>
                            <ui:SymbolIcon Symbol="CopySelect20" />
                        </baseControls:MenuButton.IconContent>
                    </baseControls:MenuButton>

                    <baseControls:MenuButton
                        x:Name="MBTN_CopyAll"
                        Margin="0,0,3,0"
                        CaptionText="Copy All as Text">
                        <baseControls:MenuButton.IconContent>
                            <ui:SymbolIcon Symbol="DocumentCopy20" />
                        </baseControls:MenuButton.IconContent>
                    </baseControls:MenuButton>

                    <baseControls:MenuButton
                        x:Name="MBTN_ClearCurrent"
                        Margin="0,0,0,0"
                        CaptionText="Clear Current Log">
                        <baseControls:MenuButton.IconContent>
                            <ui:SymbolIcon Symbol="Broom20" />
                        </baseControls:MenuButton.IconContent>
                    </baseControls:MenuButton>

                </StackPanel>
            </Border>

            <ComboBox
                x:Name="CB_LogTypes"
                Grid.Column="2"
                MinWidth="110"
                HorizontalAlignment="Right"
                FontFamily="{StaticResource FF_HypatiaSans_Semibold}"
                SelectionChanged="CB_LogTypes_SelectionChanged" />
        </Grid>

        <Border
            Grid.Row="3"
            Margin="15,7.5,15,15"
            Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
            BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
            BorderThickness="1"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ui:ListView
                    x:Name="LV_LogMessages"
                    Grid.Row="0"
                    HorizontalContentAlignment="Stretch"
                    ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                    SelectionChanged="LV_LogMessages_SelectionChanged"
                    TextElement.FontFamily="{StaticResource FF_HypatiaSans_Regular}"
                    TextElement.FontSize="12"
                    VirtualizingPanel.IsVirtualizing="True">
                    <ui:ListView.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Path=.}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ui:ListView.ItemTemplate>
                </ui:ListView>

                <Border
                    Grid.Row="1"
                    Background="{DynamicResource CardBackgroundFillColorSecondaryBrush}"
                    CornerRadius="0,0,4,4"
                    TextElement.FontFamily="{StaticResource FF_HypatiaSans_Regular}"
                    TextElement.FontSize="12"
                    TextElement.Foreground="{DynamicResource TextFillColorPrimaryBrush}">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock x:Name="TB_LogCount" Margin="15,6">
                            Count: 0
                        </TextBlock>
                        <TextBlock x:Name="TB_SelectedLog" Margin="15,6">
                            Selected: -
                        </TextBlock>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!--  MystWindow's Base Controls  -->
        <ContentPresenter
            x:Name="CPST_ContentDialog"
            Grid.Row="1"
            Grid.RowSpan="4" />
        <ui:SnackbarPresenter
            x:Name="SBPST_Base"
            Grid.Row="1"
            Grid.RowSpan="4" />

    </Grid>

</base:MystWindow>
