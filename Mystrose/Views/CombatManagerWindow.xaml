<ui:FluentWindow
    x:Class="Mystrose.Views.CombatManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Mystrose"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Combat Manager | Mystrose"
    Width="959"
    Height="631"
    MinWidth="160"
    MinHeight="40"
    ResizeMode="CanResize"
    WindowStartupLocation="CenterScreen"
    WindowState="Normal"
    mc:Ignorable="d">

    <Grid Background="{DynamicResource ControlBarFillColorSecondaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Name="TitleBar"
            Grid.Row="0"
            Height="40"
            VerticalAlignment="Top"
            Background="{DynamicResource ControlBarFillColorDefaultBrush}">

            <ui:TitleBar.Header>
                <Grid Margin="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon
                        Grid.Column="0"
                        Margin="3,0"
                        FontSize="24"
                        Symbol="TargetArrow16" />
                    <StackPanel
                        Grid.Column="1"
                        Margin="3,0"
                        Orientation="Horizontal">
                        <TextBlock
                            x:Name="TitleTxt"
                            Margin="3,0,3,3.5"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource BDMerced}"
                            FontSize="24"
                            Text="Combat Manager" />
                        <ui:SymbolIcon
                            x:Name="RedirectorIcon"
                            Margin="3,0"
                            Symbol="ChevronRight20"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="RedirectorTxt"
                            Margin="3,0,3,3.5"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource BDMerced}"
                            FontSize="24"
                            Text="Class Name"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <Border
                        Grid.Column="2"
                        Width="0.5"
                        Height="34"
                        Margin="3,0"
                        Background="{DynamicResource SeparatorStrokeColorDefaultBrush}"
                        CornerRadius="0.25" />
                </Grid>
            </ui:TitleBar.Header>
        </ui:TitleBar>
        <Rectangle
            x:Name="SeparatorRect"
            Grid.Row="1"
            Height="0.5"
            Fill="#0c0c0d" />
        <Grid Grid.Row="2" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.25*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Margin="0,0,5,0"
                Padding="2.5"
                Background="{DynamicResource ControlBarFillColorDefaultBrush}"
                CornerRadius="5">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="7.5,3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource BDMerced}"
                            FontSize="18"
                            Text="Class Loadouts" />
                        <StackPanel
                            Grid.Column="1"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <ui:Button
                                x:Name="Loadout1Btn"
                                Width="24"
                                Height="24"
                                Margin="5,0,0,0"
                                Padding="0"
                                Background="Transparent"
                                Click="OnButtonClick">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="Add24" />
                                </ui:Button.Icon>
                            </ui:Button>
                            <ui:Button
                                x:Name="Loadout0Btn"
                                Width="24"
                                Height="24"
                                Margin="5,0,0,0"
                                Padding="0"
                                Background="Transparent"
                                Click="OnButtonClick">
                                <ui:Button.Icon>
                                    <ui:SymbolIcon Symbol="LineHorizontal120" />
                                </ui:Button.Icon>
                            </ui:Button>
                        </StackPanel>
                    </Grid>
                    <Border
                        Grid.Row="1"
                        Margin="6,0"
                        BorderBrush="#52525e"
                        BorderThickness="0.5"
                        CornerRadius="0.25"
                        Opacity="0.5" />
                    <ui:TextBox
                        Grid.Row="2"
                        Margin="6,3"
                        Background="#373640"
                        PlaceholderText="Search..." />

                    <TextBlock
                        x:Name="EmptyListTxt"
                        Grid.Row="3"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontFamily="{StaticResource BDMerced}"
                        FontSize="18"
                        Opacity="0.5"
                        Text="No loadout"
                        Visibility="Visible" />
                    <ListView
                        x:Name="LoadoutsList"
                        Grid.Row="3"
                        Margin="6,3"
                        ScrollViewer.CanContentScroll="False"
                        SelectionMode="Multiple"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        Visibility="Collapsed" />
                </Grid>
            </Border>

            <Border
                Grid.Column="1"
                Padding="2.5"
                Background="{DynamicResource ControlBarFillColorDefaultBrush}"
                CornerRadius="5">
                <Grid>
                    <Image
                        x:Name="SplashScreen"
                        Width="300"
                        Height="300"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Opacity="0.1"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        SnapsToDevicePixels="True"
                        Source="pack://application:,,,/Resources/Graphics/Mystrose.png"
                        UseLayoutRounding="True"
                        Visibility="Collapsed" />
                    <Grid x:Name="LoadoutPnl" Visibility="Visible">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                x:Name="ClassTxt"
                                Grid.Column="0"
                                Margin="7.5,3"
                                VerticalAlignment="Center"
                                FontFamily="{DynamicResource BDMerced}"
                                FontSize="24"
                                Text="Class Name" />
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ui:Button
                                    x:Name="Class1Btn"
                                    Width="30"
                                    Height="30"
                                    Margin="5,0,0,0"
                                    Padding="0"
                                    Background="Transparent"
                                    Click="OnButtonClick">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Edit20" />
                                    </ui:Button.Icon>
                                </ui:Button>
                                <ui:Button
                                    x:Name="Class0Btn"
                                    Width="30"
                                    Height="30"
                                    Margin="5,0,7.5,0"
                                    Padding="0"
                                    Background="Transparent"
                                    Click="OnButtonClick">
                                    <ui:Button.Icon>
                                        <ui:SymbolIcon Symbol="Delete20" />
                                    </ui:Button.Icon>
                                </ui:Button>
                            </StackPanel>
                        </Grid>
                        <TextBlock
                            x:Name="ClassAliasTxt"
                            Grid.Row="1"
                            Margin="7.5,-2.5"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource BDMerced}"
                            FontSize="18"
                            Opacity="0.5"
                            Text="Alias - Name" />
                        <Border
                            Grid.Row="2"
                            Margin="7.5,6"
                            BorderBrush="#52525e"
                            BorderThickness="0.5"
                            CornerRadius="0.25"
                            Opacity="0.5" />
                        <ContentControl x:Name="EngineCtl" Grid.Row="3" />
                    </Grid>
                </Grid>

            </Border>
        </Grid>
    </Grid>

</ui:FluentWindow>