<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  Application  -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#2B2A33" />
    <SolidColorBrush x:Key="ApplicationBorderBrush" Color="#3A3A3A" />

    <!--  Sidebars  -->
    <SolidColorBrush x:Key="TitleBarBackgroundBrush" Color="#1C1B22" />

    <SolidColorBrush x:Key="NavigationBarBackgroundBrush" Color="#2B2A33" />

    <!--  Panels  -->
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="#2B2A33" />

    <!--  Separators  -->
    <!--<SolidColorBrush x:Key="ControlSeparatorBrush" Color="#2A292F" />-->
    <SolidColorBrush x:Key="ControlSeparatorBrush" Color="#3F3F46" />

    <SolidColorBrush x:Key="PanelSeparatorBrush" Color="#0C0C0D" />

    <!--  Buttons  -->
    <!--<SolidColorBrush x:Key="TitleBarButtonBackgroundDefaultBrush" Color="Transparent" />
    <SolidColorBrush x:Key="TitleBarButtonBackgroundHoveredBrush" Color="#34343A" />
    <SolidColorBrush x:Key="TitleBarButtonBackgroundPressedBrush" Opacity="0.5" Color="#34343A" />
    <SolidColorBrush x:Key="TitleBarButtonBackgroundSelectedBrush" Color="#42414D" />-->

    <SolidColorBrush x:Key="ButtonBackgroundDefaultBrush" Color="Transparent" />
    <SolidColorBrush x:Key="ButtonBackgroundHoveredBrush" Color="#34343A" />
    <SolidColorBrush
        x:Key="ButtonBackgroundPressedBrush"
        Opacity="0.5"
        Color="#34343A" />
    <SolidColorBrush x:Key="ButtonBackgroundSelectedBrush" Color="#42414D" />

    <!--  Menus  -->
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#42414D" />
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#52525E" />

    <!-- Context Menus -->
    <SolidColorBrush x:Key="ContextMenuBackgroundBrush" Color="#42414D" />
    <SolidColorBrush x:Key="ContextMenuBorderBrush" Color="#52525E" />

    <!--  Texts and Fills  -->
    <SolidColorBrush x:Key="TextFillPrimaryBrush">#FBFBFE</SolidColorBrush>
    <SolidColorBrush x:Key="TextFillSecondaryColor">#C5FBFBFE</SolidColorBrush>
    <SolidColorBrush x:Key="TextFillTertiaryColor">#87FBFBFE</SolidColorBrush>
    <SolidColorBrush x:Key="TextFillDisabledColor">#5DFBFBFE</SolidColorBrush>
    <SolidColorBrush x:Key="TextFillPlaceholderColor">#87FBFBFE</SolidColorBrush>
    <SolidColorBrush x:Key="TextFillInverseColor">#E4000000</SolidColorBrush>

</ResourceDictionary>