<ui:FluentWindow
    x:Class="Mystrose.Windows.ScriptManagerWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:customs="clr-namespace:Mystrose.Controls.CombatManager"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Mystrose"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:script="clr-namespace:Mystrose.ScriptMachine"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Script Manager | Mystrose"
    Width="959"
    Height="631"
    MinWidth="160"
    MinHeight="40"
    ResizeMode="CanResize"
    WindowMode="Default"
    WindowStartupLocation="CenterScreen"
    WindowState="Normal"
    mc:Ignorable="d">

    <Grid Background="{DynamicResource ControlBarFillColorSecondaryBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <ui:TitleBar
            Name="TitleBar"
            Grid.Row="0"
            Height="40"
            VerticalAlignment="Top"
            Background="{DynamicResource ControlBarFillColorDefaultBrush}">

            <ui:TitleBar.Header>
                <Grid Margin="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <ui:SymbolIcon
                        Grid.Column="0"
                        Margin="3,0"
                        FontSize="24"
                        Symbol="CodeBlock16" />
                    <StackPanel
                        Grid.Column="1"
                        Margin="3,0"
                        Orientation="Horizontal">
                        <TextBlock
                            x:Name="TitleTxt"
                            Margin="3,0,3,3.5"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource BDMerced}"
                            FontSize="24"
                            Text="Script Manager" />
                        <ui:SymbolIcon
                            x:Name="RedirectorIcon"
                            Margin="3,0"
                            Symbol="ChevronRight20"
                            Visibility="Collapsed" />
                        <TextBlock
                            x:Name="RedirectorTxt"
                            Margin="3,0,3,3.5"
                            VerticalAlignment="Center"
                            FontFamily="{DynamicResource BDMerced}"
                            FontSize="24"
                            Text="Class Name"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <Border
                        Grid.Column="2"
                        Width="0.5"
                        Height="34"
                        Margin="3,0"
                        Background="{DynamicResource SeparatorStrokeColorDefaultBrush}"
                        CornerRadius="0.25" />
                </Grid>
            </ui:TitleBar.Header>
        </ui:TitleBar>
        <Rectangle
            x:Name="SeparatorRect"
            Grid.Row="1"
            Height="0.5"
            Fill="#0c0c0d" />
        <Grid Grid.Row="2" Margin="5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <Border
                Grid.Column="0"
                Padding="2.5"
                Background="{DynamicResource ControlBarFillColorDefaultBrush}"
                CornerRadius="5">
                <ContentControl x:Name="EngineCtl" Grid.Row="3" />
            </Border>
        </Grid>
    </Grid>
</ui:FluentWindow>
