<Application
    x:Class="Mystrose.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Mystrose"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    StartupUri="pack://application:,,,/Views/Logger/VWLogger.xaml">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/Resources/ResourceDictionaries/CustomIcons.xaml" />
                <ResourceDictionary Source="pack://application:,,,/Resources/ResourceDictionaries/Fonts.xaml" />
                <ui:ThemesDictionary Theme="Dark" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
